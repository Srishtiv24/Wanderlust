<% layout('/layouts/boiler-plate') %>

<div class="ai-page">

  <!-- SIDEBAR -->
  <aside class="ai-sidebar">
    <div class="ai-sidebar-header">
        <div class="ai-sidebar-logo ai-orb-avatar">✦</div>
      <div>
        <div class="ai-sidebar-name">Travel Assistant</div>
      </div>
    </div>

    <button class="ai-new-btn" onclick="newChat()">
      <i class="fa-regular fa-pen-to-square"></i> New conversation
    </button>

    <nav class="ai-preset-nav">

      <div class="ai-category">
        <div class="ai-category-label">Find a Stay</div>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>Show me all beach listings</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>Listings under ₹1500/night</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>Most luxurious listings</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>Best listing for a couple</span>
        </button>
      </div>

      <div class="ai-category">
        <div class="ai-category-label">By Destination</div>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>Listings in Europe</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>Listings in Asia</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>Mountain or ski stays</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>Unique stays — treehouses or islands</span>
        </button>
      </div>

      <div class="ai-category">
        <div class="ai-category-label">Plan an Itinerary</div>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>3-day trip to Coorg for a couple, moderate budget</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>5-day Goa trip for friends, budget travel</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>7-day family trip to Rajasthan</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>Solo 4-day spiritual trip to Varanasi</span>
        </button>
      </div>

      <div class="ai-category">
        <div class="ai-category-label">Travel Tips</div>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>What to pack for a hill station trip</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>Best time to visit Ladakh</span>
        </button>
        <button onclick="sendPreset(this)" class="ai-preset-item">
          <span>How to travel India on a tight budget</span>
        </button>
      </div>

    </nav>
  </aside>

  <!-- MAIN CHAT -->
  <div class="ai-main">

    <!-- Header -->
    <header class="ai-header">
      <div class="ai-header-left">
        <span class="ai-header-title">AI Travel Assistant</span>
        <span class="ai-header-sep">·</span>
        <span class="ai-header-status" id="aiStatusLine">
          <span class="ai-dot" id="aiDot"></span>
          <span id="aiStatusText">Ready</span>
        </span>
      </div>
      <button class="ai-header-action" onclick="newChat()" title="New chat">
        <i class="fa-regular fa-pen-to-square"></i>
        <span>New chat</span>
      </button>
    </header>

    <!-- Messages -->
    <div class="ai-messages" id="aiMessages">

      <div class="ai-welcome" id="aiWelcome">
        <div class="ai-welcome-inner"> 

            <div class="ai-welcome-star">✦</div>
          <h2>How can I help you today<% if(currUser){ %>, <%= currUser.username.charAt(0).toUpperCase() + currUser.username.slice(1) %><% } %>?</h2>
          <p>Ask me to plan a trip, find the right stay, or get any travel advice for India and beyond.</p>

          <div class="ai-suggestions">
            <button class="ai-suggestion" onclick="sendPreset(this)">
              <i class="fa-solid fa-umbrella-beach"></i>
              <span>Show me all beach listings</span>
            </button>
            <button class="ai-suggestion" onclick="sendPreset(this)">
              <i class="fa-solid fa-mountain-sun"></i>
              <span>Mountain or ski stays</span>
            </button>
            <button class="ai-suggestion" onclick="sendPreset(this)">
              <i class="fa-solid fa-plane-departure"></i>
              <span>3-day trip to Coorg for a couple</span>
            </button>
            <button class="ai-suggestion" onclick="sendPreset(this)">
              <i class="fa-solid fa-indian-rupee-sign"></i>
              <span>Listings under ₹1500/night</span>
            </button>
            <button class="ai-suggestion" onclick="sendPreset(this)">
              <i class="fa-solid fa-crown"></i>
              <span>Most luxurious listings</span>
            </button>
            <button class="ai-suggestion" onclick="sendPreset(this)">
              <i class="fa-solid fa-earth-asia"></i>
              <span>Listings in Asia</span>
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- Input -->
    <div class="ai-input-area">
      <div class="ai-input-box" id="aiInputBox">
        <textarea
          id="aiInput"
          placeholder="Ask anything about travel…"
          rows="1"
          onkeydown="handleKey(event)"
          oninput="autoResize(this)"
        ></textarea>
        <button class="ai-send" id="aiSendBtn" onclick="sendMessage()">
          <i class="fa-solid fa-arrow-up"></i>
        </button>
      </div>
    </div>

  </div>
</div>

<% if (typeof autoPrompt !== 'undefined' && autoPrompt) { %>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      // Expose to all JS in this page — including sendMessage
      window.autoDestination = `<%- (autoDestination || '').replace(/`/g, "'") %>`;
    
      const prompt = `<%- autoPrompt.replace(/`/g, "'") %>`;
      if (prompt && typeof sendMessage === 'function') {
        const input = document.getElementById('aiInput');
        if (input) {
          input.value = prompt;
          setTimeout(() => sendMessage(), 250);
        }
      }
    });
</script>
<% } %>
