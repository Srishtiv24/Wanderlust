<% layout('/layouts/boiler-plate') %>

<div style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 2rem;">
  <div style="text-align: center; max-width: 420px;">
    <div style="font-size: 4rem; margin-bottom: 1rem; color: var(--primary);">
      <i class="fa-regular fa-compass"></i>
    </div>
    
    <h2 style="font-family: 'Bricolage Grotesque', sans-serif; 
               font-size: 1.6rem; 
               font-weight: 700; 
               color: var(--primary); 
               margin-bottom: 0.5rem;">
      Oops! Lost on the map.
    </h2>
    
    <p>
      We couldn’t complete your request.
    </p>
    
    <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;"><%= message %></p>
    <a href="/listings" class="wl-btn-primary" style="display: inline-flex;">
      <i class="fa-solid fa-house"></i> Back to Explore
    </a>
  </div>
</div>
