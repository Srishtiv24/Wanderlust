<% layout('/layouts/boiler-plate') %>

<body>
    <br>
    <br>
    <div class="row offset-2" >
    <h3>Edit Listing</h3>
    <form method="post" action="/listings/<%=listing.id%>?_method=patch"  class="needs-validation" novalidate enctype="multipart/form-data">
    <div class="col-8 mb-3" >
    <label for="title" class="form-label">Title</label>
    <input type="text" value="<%=listing.title%>" name="listing[title]" class="form-control" required>
    <div class="valid-feedback">
      Looks good!
    </div>
    </div>
    <div class="col-8 mb-3" >
    <label for="description" class="form-label">Description</label>
    <textarea name="listing[description]" class="form-control" required><%=listing.description%></textarea>
    </div>
      
    <div class="mb-3" >
      Original Listing Image <br>
    <image src="<%=listing.image.url%>" alt="listing-image"></image>
    </div>

    <div class="col-8 mb-3" >
    <label for="image" class="form-label">Upload New Image</label>
    <input type="file"  name="listing[image]" class="form-control" >
    </div>

    <div class="row  mb-3" >
      <div class="col-md-3">

    <label for="price" class="form-label" >Price</label>
    <input type="number" value="<%=listing.price%>" name="listing[price]" class="form-control" required>
    <div class="invalid-feedback">
      Please provide a valid price.
    </div>
    </div>
    <div class="col-md-5">
      <label for="country" class="form-label" >Country</label>
    <input type="text" value="<%=listing.country%>" name="listing[location]" class="form-control" required>
    <div class="invalid-feedback">
      Please provide a valid country.
    </div>
    </div>
    </div>
    <div class="col-8 mb-3" >
      <label for="location" class="form-label" >Location</label>
    <input type="text" value="<%=listing.location%>" name="listing[country]" class="form-control" required>
    <div class="invalid-feedback">
      Please provide a valid location.
    </div>
    </div>
    <button type="submit" class="btn btn-dark edit-btn">Edit</button>
    </form>
  </div>
  <br>
  <br>
</body>
</html>

<!--- The spread operator
 ... takes all key-value pairs from that object and copies them into a new object.
  listing: {
    title: "Mountain Cabin",
    price: "1500",
    location: "Manali",
    country: "India"
  }
}
output of {...req.body.listing}
{
  title: 'Mountain Cabin',
  price: '1500',
  location: 'Manali',
  country: 'India'
}
-->