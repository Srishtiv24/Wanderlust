<% layout('/layouts/boiler-plate') %>

<%
  const avgRating = listing.reviews.length > 0
    ? (listing.reviews.reduce((sum, r) => sum + (r.rating || 0), 0) / listing.reviews.length).toFixed(1)
    : null;
  const totalPerNight = Math.floor(listing.price * 1.18) + 500;
  const allMedia = [
    { url: listing.image.url, type: 'image' },
    ...(listing.gallery || [])
  ];
%>

<style>
  /* ── Reset & Base ─────────────────────────── */
  .sp-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  .sp-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: start;
  }

  @media(max-width:980px) {
    .sp-grid {
      grid-template-columns: 1fr;
    }

    .sp-sidebar {
      position: static !important;
    }
  }

  @media(max-width:600px) {
    .sp-wrap {
      padding: 0 .75rem 3rem;
    }
  }

  /* ── Hero Photo Grid ──────────────────────── */
  .sp-photo-grid {
    display: grid;
    gap: .3rem;
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 1.75rem;
    height: 440px;
  }

  .sp-photo-grid.has-many {
    grid-template-columns: 3fr 2fr;
    grid-template-rows: 1fr 1fr;
  }

  .sp-photo-grid .sp-main {
    grid-row: 1 / 3;
  }

  .sp-photo-cell {
    position: relative;
    overflow: hidden;
    background: #f0f0f0;
    cursor: pointer;
  }

  .sp-photo-cell img,
  .sp-photo-cell video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .45s ease;
  }

  .sp-photo-cell:hover img,
  .sp-photo-cell:hover video {
    transform: scale(1.04);
  }

  .sp-play-badge {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, .28);
    pointer-events: none;
  }

  .sp-play-badge i {
    font-size: 1.4rem;
    color: #fff;
  }

  .sp-show-all {
    position: absolute;
    bottom: .8rem;
    right: .8rem;
    background: white;
    border: none;
    border-radius: 8px;
    padding: .38rem .85rem;
    font-size: .75rem;
    font-weight: 700;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: .4rem;
    box-shadow: 0 2px 12px rgba(0, 0, 0, .18);
    transition: box-shadow .2s;
    z-index: 2;
  }

  .sp-show-all:hover {
    box-shadow: 0 4px 18px rgba(0, 0, 0, .28);
  }

  /* ── Section Card ─────────────────────────── */
  .sp-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 14px rgba(0, 0, 0, .06);
  }

  .sp-card-title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: .95rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: .6rem;
    margin-bottom: 1.1rem;
    padding-bottom: .85rem;
    border-bottom: 1px solid var(--border);
  }

  .sp-card-title .icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .78rem;
    flex-shrink: 0;
    background: var(--primary-soft);
  }

  .sp-card-title .icon i {
    color: var(--primary);
  }

  /* ── Chips ────────────────────────────────── */
  .sp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    margin-top: 1rem;
  }

  .sp-chip {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .32rem .8rem;
    border-radius: 25px;
    border: 1.5px solid var(--border);
    font-size: .75rem;
    font-weight: 500;
    background: var(--bg);
    color: var(--text-muted);
  }

  .sp-chip.primary {
    border-color: rgba(232, 57, 42, .25);
    color: var(--primary);
    background: var(--primary-soft);
  }

  .sp-chip.verified {
    border-color: rgba(232, 57, 42, .2);
    color: var(--primary);
    background: var(--primary-soft);
  }

  .sp-chip.country {
    border-color: rgba(232, 57, 42, .15);
    color: var(--primary);
    background: var(--primary-soft);
  }

  .sp-chip.rating {
    border-color: rgba(232, 57, 42, .15);
    color: var(--primary);
    background: var(--primary-soft);
  }

  /* ── Gallery Grid ─────────────────────────── */
  .sp-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: .5rem;
  }

  .sp-gallery-cell {
    position: relative;
    aspect-ratio: 4/3;
    border-radius: 10px;
    overflow: hidden;
    background: #ebebeb;
    cursor: pointer;
  }

  .sp-gallery-cell img,
  .sp-gallery-cell video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .35s;
  }

  .sp-gallery-cell:hover img,
  .sp-gallery-cell:hover video {
    transform: scale(1.07);
  }

  .sp-gallery-del {
    position: absolute;
    top: .35rem;
    right: .35rem;
    width: 24px;
    height: 24px;
    background: rgba(232, 57, 42, .92);
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .6rem;
    opacity: 0;
    transition: opacity .2s;
    z-index: 3;
    backdrop-filter: blur(4px);
  }

  .sp-gallery-cell:hover .sp-gallery-del {
    opacity: 1;
  }

  .sp-gallery-del:hover {
    background: #c62f22 !important;
    transform: scale(1.1);
  }

  /* ── Upload zone ──────────────────────────── */
  .sp-drop {
    border: 2px dashed #ddd;
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
    cursor: pointer;
    transition: all .2s;
    background: var(--bg);
    margin-bottom: .85rem;
  }

  .sp-drop:hover,
  .sp-drop.over {
    border-color: var(--primary);
    background: var(--primary-soft);
  }

  .sp-drop i {
    font-size: 1.8rem;
    color: #ccc;
    display: block;
    margin-bottom: .4rem;
  }

  .sp-drop p {
    font-size: .8rem;
    color: var(--text-muted);
    margin: 0;
  }

  .sp-drop strong {
    color: var(--primary);
  }

  /* ── Preview strip ────────────────────────── */
  #ownerPreview,
  #reviewPreview {
    display: flex;
    gap: .45rem;
    flex-wrap: wrap;
    margin-top: .6rem;
  }

  .prev-thumb {
    width: 64px;
    height: 52px;
    border-radius: 7px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
    border: 2px solid var(--border);
  }

  .prev-thumb img,
  .prev-thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pv-badge {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, .3);
    pointer-events: none;
  }

  .pv-badge i {
    color: white;
    font-size: .65rem;
  }

  /* ── Review card ──────────────────────────── */
  .sp-rev {
    background: var(--bg);
    border-radius: 12px;
    padding: 1rem 1.1rem;
    border: 1.5px solid var(--border);
    transition: box-shadow .2s;
  }

  .sp-rev:hover {
    box-shadow: 0 3px 14px rgba(0, 0, 0, .08);
  }

  /* ── Sidebar ──────────────────────────────── */
  .sp-sidebar {
    position: sticky;
    top: calc(var(--navbar-height) + 1.25rem);
  }

  .sp-price-card {
    background: #fff;
    border-radius: 18px;
    padding: 1.5rem;
    border: 1.5px solid var(--border);
    box-shadow: 0 4px 28px rgba(0, 0, 0, .09);
    margin-bottom: 1rem;
  }

  .sp-price-big {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
  }

  .sp-price-big small {
    font-size: 1rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .sp-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1rem 0;
  }

  .sp-row {
    display: flex;
    justify-content: space-between;
    font-size: .85rem;
    margin-bottom: .5rem;
  }

  .sp-row.total {
    font-weight: 700;
    font-size: .95rem;
  }

  .sp-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    width: 100%;
    padding: .82rem;
    border-radius: 10px;
    font-size: .88rem;
    font-weight: 700;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: all .2s;
    margin-top: 1rem;
  }

  .sp-cta.primary {
    background: var(--primary);
    color: white;
  }

  .sp-cta.primary:hover {
    background: #c62f22;
  }

  .sp-cta.outline {
    background: white;
    color: var(--text);
    border: 1.5px solid var(--border);
    margin-top: .5rem;
  }

  .sp-cta.outline:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* ── Map ──────────────────────────────────── */
  #map {
    height: 300px;
    border-radius: 10px;
  }

  /* ── Stat chips in sidebar ────────────────── */
  .sp-stat-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .5rem;
    font-size: .75rem;
    color: var(--text-muted);
  }

  .sp-stat-row span {
    display: flex;
    align-items: center;
    gap: .35rem;
  }

  .sp-stat-row i {
    color: var(--primary);
  }

  /* ── Lightbox ─────────────────────────────── */
  #sp-lb {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .96);
    z-index: 10000;
    align-items: center;
    justify-content: center;
  }

  #sp-lb.open {
    display: flex;
  }

  #sp-lb img,
  #sp-lb video {
    max-width: 90vw;
    max-height: 88vh;
    border-radius: 10px;
    object-fit: contain;
  }

  .lb-close {
    position: fixed;
    top: 1rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, .12);
    border: none;
    color: white;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .15s;
  }

  .lb-close:hover {
    background: rgba(255, 255, 255, .22);
  }

  .lb-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, .12);
    border: none;
    color: white;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .15s;
  }

  .lb-nav:hover {
    background: rgba(255, 255, 255, .25);
  }

  #lb-prev {
    left: 1rem;
  }

  #lb-next {
    right: 1rem;
  }

  .lb-counter {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, .5);
    color: white;
    border-radius: 20px;
    padding: .3rem .85rem;
    font-size: .78rem;
    backdrop-filter: blur(4px);
  }

  /* ── Confirm delete modal ─────────────────── */
  .sp-confirm-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .55);
    z-index: 20000;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }

  .sp-confirm-overlay.open {
    display: flex;
  }

  .sp-confirm-box {
    background: white;
    border-radius: 16px;
    padding: 1.75rem;
    max-width: 360px;
    width: 90%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, .25);
    animation: popIn .2s ease;
  }

  @keyframes popIn {
    from {
      transform: scale(.92);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .sp-confirm-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--primary-soft);
    margin: 0 auto .9rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sp-confirm-icon i {
    color: var(--primary);
    font-size: 1.3rem;
  }

  .sp-confirm-box h4 {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: .35rem;
  }

  .sp-confirm-box p {
    font-size: .82rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .sp-confirm-btns {
    display: flex;
    gap: .6rem;
  }

  .sp-confirm-btns button {
    flex: 1;
    padding: .62rem;
    border-radius: 10px;
    font-size: .85rem;
    font-weight: 700;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    border: none;
    transition: all .2s;
  }

  .sp-confirm-cancel {
    background: var(--bg);
    color: var(--text);
    border: 1.5px solid var(--border) !important;
  }

  .sp-confirm-cancel:hover {
    border-color: var(--primary) !important;
    color: var(--primary);
  }

  .sp-confirm-delete {
    background: var(--primary);
    color: white;
  }

  .sp-confirm-delete:hover {
    background: #c62f22;
  }
</style>


<!-- BREADCRUMB -->
<div
  style="max-width:1180px;margin:0 auto;padding:.9rem 1.5rem 0;display:flex;align-items:center;gap:.4rem;font-size:.76rem;color:var(--text-muted);">
  <a href="/listings"
    style="color:var(--text-muted);text-decoration:none;display:flex;align-items:center;gap:.3rem;transition:color .2s;"
    onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-muted)'">
    <i class="fa-solid fa-house" style="font-size:.66rem;"></i> Listings
  </a>
  <i class="fa-solid fa-chevron-right" style="font-size:.5rem;"></i>
  <span style="color:var(--text);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
    <%= listing.title.length > 52 ? listing.title.slice(0,52)+'…' : listing.title %>
  </span>
</div>


<div class="sp-wrap" style="padding-top:1rem;">

  <!-- TITLE ROW -->
  <div
    style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;">
    <div style="min-width:0;">
      <h1
        style="font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(1.4rem,3vw,1.9rem);font-weight:700;line-height:1.15;margin-bottom:.4rem;">
        <%= listing.title %>
      </h1>
      <div style="display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;font-size:.83rem;color:var(--text-muted);">
        <% if(avgRating) { %>
        <span style="display:flex;align-items:center;gap:.25rem;font-weight:700;color:var(--text);">
          <i class="fa-solid fa-star" style="color:var(--primary);font-size:.78rem;"></i>
          <%= avgRating %>
          <span style="font-weight:400;color:var(--text-muted);">(<%= listing.reviews.length %>
            review<%= listing.reviews.length!==1?'s':'' %>)</span>
        </span>
        <span style="color:#ddd;">·</span>
        <% } %>
        <span>
          <i class="fa-solid fa-location-dot" style="color:var(--primary);font-size:.76rem;margin-right:.2rem;"></i>
          <strong style="color:var(--text);"><%= listing.location %>, <%= listing.country %></strong>
        </span>
        <span style="color:#ddd;">·</span>
        <span>Host: <strong style="color:var(--text);"><%= listing.owner.username %></strong></span>
      </div>
    </div>
    <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
    <div style="display:flex;gap:.45rem;flex-shrink:0;margin-top:.2rem;">
      <form method="get" action="/listings/<%= listing._id %>/edit" style="margin:0;">
        <button type="submit" class="wl-action-btn danger">
          <i class="fa-regular fa-pen-to-square"></i> Edit
        </button>
      </form>
      <form method="post" action="/listings/<%= listing._id %>?_method=Delete" style="margin:0;">
        <button type="submit" class="wl-action-btn danger">
          <i class="fa-regular fa-trash-can"></i> Delete
        </button>
      </form>
    </div>
    <% } %>
  </div>

  <!-- PHOTO GRID -->
  <div class="sp-photo-grid <%= allMedia.length >= 3 ? 'has-many' : '' %>"
    style="<%= allMedia.length < 3 ? 'grid-template-columns:1fr;' : '' %>">
    <% allMedia.slice(0, 3).forEach(function(m, i) { %>
    <div class="sp-photo-cell <%= i === 0 && allMedia.length >= 3 ? 'sp-main' : '' %>" onclick="openLb(<%= i %>)">
      <% if(m.type === 'video') { %>
      <video src="<%= m.url %>" muted playsinline preload="metadata"></video>
      <div class="sp-play-badge"><i class="fa-solid fa-play"></i></div>
      <% } else { %>
      <img src="<%= m.url %>" alt="<%= listing.title %> photo <%= i+1 %>">
      <% } %>
      <% if(i === 2 && allMedia.length > 3) { %>
      <button class="sp-show-all" onclick="event.stopPropagation();openLb(2)">
        <i class="fa-regular fa-images"></i> +<%= allMedia.length - 3 %> more
      </button>
      <% } %>
    </div>
    <% }); %>
  </div>

  <!-- MAIN GRID -->
  <div class="sp-grid">

    <!-- LEFT COLUMN -->
    <div>

      <!-- About -->
      <div class="sp-card">
        <div class="sp-card-title">
          <span class="icon"><i class="fa-regular fa-file-lines"></i></span>
          About this stay
        </div>
        <p style="color:var(--text-muted);font-size:.88rem;line-height:1.9;white-space:pre-line;">
          <%= listing.description %></p>
        <div class="sp-chips">
          <span class="sp-chip primary">
            <i class="fa-solid fa-indian-rupee-sign"></i> ₹<%= listing.price.toLocaleString('en-IN') %>/night
          </span>
          <span class="sp-chip verified">
            <i class="fa-solid fa-shield-halved"></i> Verified Stay
          </span>
          <span class="sp-chip country">
            <i class="fa-solid fa-earth-asia"></i> <%= listing.country %>
          </span>
          <% if(avgRating) { %>
          <span class="sp-chip rating">
            <i class="fa-solid fa-star"></i> <%= avgRating %> avg
          </span>
          <% } %>
        </div>
      </div>

      <!-- Owner: Upload Gallery -->
      <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
      <div class="sp-card" style="border:2px dashed #e4e4e4;">
        <div class="sp-card-title">
          <span class="icon"><i class="fa-solid fa-camera"></i></span>
          Add Photos &amp; Videos
          <span style="font-size:.72rem;font-weight:400;color:var(--text-muted);margin-left:auto;">
            <%= (listing.gallery||[]).length %> in gallery
          </span>
        </div>
        <form method="post" action="/listings/<%= listing._id %>/gallery" enctype="multipart/form-data"
          id="galleryUploadForm">
          <div class="sp-drop" id="ownerDrop" ondragover="event.preventDefault();this.classList.add('over')"
            ondragleave="this.classList.remove('over')" ondrop="ownerDrop(event)"
            onclick="document.getElementById('ownerFileInput').click()">
            <i class="fa-regular fa-images"></i>
            <p>Drag &amp; drop or <strong>browse</strong> to add photos &amp; videos</p>
            <p style="font-size:.7rem;margin-top:.2rem;opacity:.65;">JPG · PNG · WebP · MP4 · MOV · Max 10 files</p>
          </div>
          <input type="file" id="ownerFileInput" name="gallery" multiple
            accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/*" style="display:none;"
            onchange="ownerPreview(this.files)">
          <div id="ownerPreview"></div>
          <div style="display:flex;gap:.6rem;margin-top:.9rem;align-items:center;">
            <button type="submit" class="wl-submit-btn" id="ownerUploadBtn" disabled
              style="padding:.55rem 1.2rem;font-size:.85rem;display:inline-flex;align-items:center;gap:.4rem;opacity:.4;cursor:not-allowed;">
              <i class="fa-solid fa-upload"></i> Upload
            </button>
            <span id="ownerFileCount" style="font-size:.78rem;color:var(--text-muted);"></span>
          </div>
        </form>
      </div>
      <% } %>

      <!-- Gallery Display -->
      <% if(listing.gallery && listing.gallery.length > 0) { %>
      <div class="sp-card">
        <div class="sp-card-title">
          <span class="icon"><i class="fa-regular fa-images"></i></span>
          Gallery
          <span style="font-size:.75rem;font-weight:400;color:var(--text-muted);">(<%= listing.gallery.length %>)</span>
        </div>
        <div class="sp-gallery-grid">
          <% listing.gallery.forEach(function(m, gi) { %>
          <div class="sp-gallery-cell">
            <% if(m.type === 'video') { %>
            <video src="<%= m.url %>" muted preload="metadata" onclick="openLb(<%= gi + 1 %>)"
              style="cursor:pointer;"></video>
            <div class="sp-play-badge" style="pointer-events:none;">
              <i class="fa-solid fa-play" style="font-size:.9rem;"></i>
            </div>
            <% } else { %>
            <img src="<%= m.url %>" alt="gallery <%= gi+1 %>" onclick="openLb(<%= gi + 1 %>)" style="cursor:pointer;">
            <% } %>
            <!-- Delete button (owner only) -->
            <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
            <form method="post" action="/listings/<%= listing._id %>/gallery/delete"
              style="margin:0;position:absolute;top:.35rem;right:.35rem;z-index:3;" onsubmit="return false;"
              data-filename="<%= m.filename %>">
              <input type="hidden" name="filename" value="<%= m.filename %>">
              <input type="hidden" name="_method" value="DELETE">
              <button type="button" class="sp-gallery-del" title="Delete photo" onclick="confirmGalleryDelete(this)">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </form>
            <% } %>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- Map -->
      <div class="sp-card">
        <div class="sp-card-title">
          <span class="icon"><i class="fa-solid fa-location-dot"></i></span>
          Where you'll be
        </div>
        <p style="font-size:.82rem;color:var(--text-muted);margin-bottom:.85rem;">
          <i class="fa-solid fa-map-pin" style="color:var(--primary);font-size:.72rem;margin-right:.3rem;"></i>
          <%= listing.location %>, <%= listing.country %>
        </p>
        <div id="map"></div>
        <script id="map-data" type="application/json">
          < % -JSON.stringify({
            lat,
            lng,
            title: listing.title,
            location: listing.location,
            country: listing.country
          }) % >
        </script>
      </div>

      <!-- Review form -->
      <% if(currUser) { %>
      <div class="sp-card">
        <div class="sp-card-title">
          <span class="icon"><i class="fa-regular fa-pen-to-square"></i></span>
          Leave a Review
        </div>
        <form method="post" action="/listings/<%= listing._id %>/reviews" class="needs-validation" novalidate
          enctype="multipart/form-data">
          <div style="margin-bottom:1rem;">
            <label class="wl-form-label">Your Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                aria-label="No rating." />
              <input type="radio" id="rate1" name="review[rating]" value="1" /><label for="rate1" title="Terrible">1
                star</label>
              <input type="radio" id="rate2" name="review[rating]" value="2" /><label for="rate2" title="Not good">2
                stars</label>
              <input type="radio" id="rate3" name="review[rating]" value="3" /><label for="rate3" title="Average">3
                stars</label>
              <input type="radio" id="rate4" name="review[rating]" value="4" /><label for="rate4" title="Very good">4
                stars</label>
              <input type="radio" id="rate5" name="review[rating]" value="5" /><label for="rate5" title="Amazing">5
                stars</label>
            </fieldset>
          </div>
          <div style="margin-bottom:1rem;">
            <label class="wl-form-label">Your Comment</label>
            <textarea name="review[comment]" rows="3" class="wl-form-control" required
              placeholder="Share your experience…"></textarea>
            <div class="invalid-feedback">Please add a comment.</div>
          </div>
          <div style="margin-bottom:1rem;">
            <label class="wl-form-label">
              <i class="fa-regular fa-image" style="color:var(--primary);margin-right:.3rem;"></i>
              Photos / Videos <span style="font-weight:400;color:var(--text-muted);">(optional · up to 5)</span>
            </label>
            <div class="sp-drop" id="reviewDrop" ondragover="event.preventDefault();this.classList.add('over')"
              ondragleave="this.classList.remove('over')" ondrop="revDrop(event)"
              onclick="document.getElementById('reviewFileInput').click()">
              <i class="fa-regular fa-images" style="font-size:1.5rem;"></i>
              <p>Drag &amp; drop or <strong>browse</strong></p>
              <p style="font-size:.7rem;opacity:.65;margin-top:.15rem;">JPG · PNG · WebP · MP4 · MOV</p>
            </div>
            <input type="file" id="reviewFileInput" name="reviewMedia" multiple
              accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/*" style="display:none;"
              onchange="reviewPreview(this.files)">
            <div id="reviewPreview"></div>
          </div>
          <button type="submit" class="wl-submit-btn" style="display:inline-flex;align-items:center;gap:.4rem;">
            <i class="fa-regular fa-paper-plane"></i> Submit Review
          </button>
        </form>
      </div>
      <% } else { %>
      <div
        style="background:var(--primary-soft);border-radius:14px;padding:1.1rem 1.25rem;margin-bottom:1rem;border:1.5px solid rgba(232,57,42,.18);display:flex;align-items:center;gap:.85rem;">
        <div
          style="width:36px;height:36px;border-radius:50%;background:var(--primary);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i class="fa-solid fa-lock" style="color:white;font-size:.8rem;"></i>
        </div>
        <p style="font-size:.88rem;margin:0;">
          <a href="/login" style="color:var(--primary);font-weight:700;">Log in</a> to leave a review.
        </p>
      </div>
      <% } %>

      <!-- Reviews list -->
      <% if(listing.reviews.length > 0) { %>
      <div class="sp-card">
        <div class="sp-card-title">
          <span class="icon"><i class="fa-solid fa-star"></i></span>
          Reviews
          <span style="font-size:.78rem;font-weight:500;color:var(--text-muted);">(<%= listing.reviews.length %>)</span>
          <% if(avgRating) { %>
          <span
            style="margin-left:auto;font-size:.85rem;font-weight:700;color:var(--primary);display:flex;align-items:center;gap:.3rem;">
            <i class="fa-solid fa-star"></i> <%= avgRating %> / 5
          </span>
          <% } %>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:.7rem;">
          <% for(let review of listing.reviews) { %>
          <div class="sp-rev">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.55rem;">
              <div style="display:flex;align-items:center;gap:.5rem;">
                <div
                  style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;color:white;font-size:.8rem;font-weight:700;flex-shrink:0;">
                  <%= review.author.username.charAt(0).toUpperCase() %>
                </div>
                <div>
                  <div style="font-size:.83rem;font-weight:700;">@<%= review.author.username %></div>
                  <div style="font-size:.67rem;color:var(--text-muted);">
                    <%= new Date(review.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                  </div>
                </div>
              </div>
              <% if(currUser && currUser._id.equals(review.author._id)) { %>
              <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=Delete"
                style="margin:0;">
                <button type="submit"
                  style="background:none;border:none;padding:.22rem .35rem;border-radius:6px;color:var(--text-muted);cursor:pointer;font-size:.75rem;transition:all .15s;"
                  onmouseover="this.style.background='var(--primary-soft)';this.style.color='var(--primary)'"
                  onmouseout="this.style.background='none';this.style.color='var(--text-muted)'">
                  <i class="fa-regular fa-trash-can"></i>
                </button>
              </form>
              <% } %>
            </div>
            <p class="starability-result" data-rating="<%= review.rating %>" style="margin-bottom:.45rem;"></p>
            <p style="font-size:.83rem;color:var(--text-muted);line-height:1.65;margin-bottom:.45rem;">
              <%= review.comment %></p>
            <% if(review.media && review.media.length > 0) { %>
            <div style="display:flex;gap:.35rem;flex-wrap:wrap;">
              <% for(let m of review.media) { %>
              <div
                style="width:60px;height:48px;border-radius:6px;overflow:hidden;cursor:pointer;position:relative;flex-shrink:0;"
                onclick="openLbSingle('<%= m.url %>','<%= m.type %>')">
                <% if(m.type==='video') { %>
                <video src="<%= m.url %>" muted style="width:100%;height:100%;object-fit:cover;"></video>
                <div
                  style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.3);">
                  <i class="fa-solid fa-play" style="color:white;font-size:.6rem;"></i>
                </div>
                <% } else { %>
                <img src="<%= m.url %>" style="width:100%;height:100%;object-fit:cover;">
                <% } %>
              </div>
              <% } %>
            </div>
            <% } %>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>

    </div><!-- /left -->

    <!-- SIDEBAR -->
    <div class="sp-sidebar">
      <div class="sp-price-card">
        <div style="display:flex;align-items:baseline;gap:.4rem;margin-bottom:.3rem;">
          <span class="sp-price-big">₹<%= listing.price.toLocaleString('en-IN') %></span>
          <small>/ night</small>
        </div>
        <% if(avgRating) { %>
        <div style="display:flex;align-items:center;gap:.35rem;font-size:.83rem;margin-bottom:1rem;">
          <i class="fa-solid fa-star" style="color:var(--primary);font-size:.75rem;"></i>
          <strong><%= avgRating %></strong>
          <span style="color:var(--text-muted);">· <%= listing.reviews.length %>
            review<%= listing.reviews.length!==1?'s':'' %></span>
        </div>
        <% } else { %>
        <div style="font-size:.8rem;color:var(--text-muted);margin-bottom:1rem;">No reviews yet</div>
        <% } %>
        <hr class="sp-divider">
        <div class="sp-row">
          <span style="color:var(--text-muted);">₹<%= listing.price.toLocaleString('en-IN') %> × 1 night</span>
          <span>₹<%= listing.price.toLocaleString('en-IN') %></span>
        </div>
        <div class="sp-row">
          <span style="color:var(--text-muted);">GST (18%)</span>
          <span>₹<%= Math.floor(listing.price * 0.18).toLocaleString('en-IN') %></span>
        </div>
        <div class="sp-row">
          <span style="color:var(--text-muted);">Cleaning fee</span>
          <span>₹500</span>
        </div>
        <hr class="sp-divider" style="margin:.6rem 0;">
        <div class="sp-row total">
          <span>Total / night</span>
          <span style="color:var(--primary);">₹<%= totalPerNight.toLocaleString('en-IN') %></span>
        </div>
        <a href="/ai-assistant?prompt=<%= encodeURIComponent('Tell me about ' + listing.title) %>&destination=<%= encodeURIComponent(listing.location) %>"
          class="sp-cta primary">
          <i class="fa-solid fa-robot"></i> Ask AI about this stay
        </a>
        <a href="/itinerary?destination=<%= encodeURIComponent(listing.location) %>" class="sp-cta outline">
          <i class="fa-solid fa-map"></i> Plan a trip to <%= listing.location %>
        </a>
        <p style="font-size:.68rem;color:var(--text-muted);text-align:center;margin-top:.75rem;">
          Includes 18% GST + ₹500 cleaning fee
        </p>
      </div>

      <!-- Host card -->
      <div class="sp-price-card">
        <div
          style="font-size:.67rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--text-muted);margin-bottom:.85rem;">
          Your Host</div>
        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1rem;">
          <div style="position:relative;flex-shrink:0;">
            <div
              style="width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:1.05rem;">
              <%= listing.owner.username.charAt(0).toUpperCase() %>
            </div>
            <div
              style="position:absolute;bottom:0;right:0;width:13px;height:13px;background:var(--primary);border-radius:50%;border:2px solid white;opacity:.75;">
            </div>
          </div>
          <div>
            <div style="font-weight:700;font-size:.9rem;"><%= listing.owner.username %></div>
            <div style="font-size:.72rem;color:var(--text-muted);">Wanderlust Host</div>
          </div>
        </div>
        <div class="sp-stat-row">
          <span><i class="fa-solid fa-shield-halved"></i> Verified</span>
          <span><i class="fa-regular fa-comment-dots"></i> <%= listing.reviews.length %> reviews</span>
          <span><i class="fa-regular fa-clock"></i> Fast replies</span>
          <span><i class="fa-solid fa-house"></i> Active host</span>
        </div>
      </div>
    </div>

  </div><!-- /sp-grid -->
</div><!-- /sp-wrap -->


<!-- LIGHTBOX -->
<div id="sp-lb">
  <button class="lb-close" onclick="closeLb()"><i class="fa-solid fa-xmark"></i></button>
  <button class="lb-nav" id="lb-prev" onclick="lbStep(-1)"><i class="fa-solid fa-chevron-left"></i></button>
  <img id="lb-img" src="" alt="" style="display:none;">
  <video id="lb-vid" controls style="display:none;"></video>
  <button class="lb-nav" id="lb-next" onclick="lbStep(1)"><i class="fa-solid fa-chevron-right"></i></button>
  <div class="lb-counter" id="lb-counter"></div>
</div>

<!-- DELETE CONFIRM MODAL -->
<div class="sp-confirm-overlay" id="delConfirmOverlay">
  <div class="sp-confirm-box">
    <div class="sp-confirm-icon"><i class="fa-regular fa-trash-can"></i></div>
    <h4>Delete this photo?</h4>
    <p>This action cannot be undone. The photo will be permanently removed from the gallery.</p>
    <div class="sp-confirm-btns">
      <button class="sp-confirm-cancel" onclick="closeDelConfirm()">Cancel</button>
      <button class="sp-confirm-delete" id="delConfirmBtn">Delete</button>
    </div>
  </div>
</div>


<script>
  /* ── Lightbox ─────────────────────────────── */
  const MEDIA = < % -JSON.stringify(allMedia) % > ;
  let lbIdx = 0,
    lbSingle = false;

  function openLb(idx) {
    lbSingle = false;
    lbIdx = idx;
    ['lb-prev', 'lb-next', 'lb-counter'].forEach(id => document.getElementById(id).style.display = '');
    showLbItem();
    document.getElementById('sp-lb').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function openLbSingle(url, type) {
    lbSingle = true;
    const img = document.getElementById('lb-img'),
      vid = document.getElementById('lb-vid');
    img.style.display = vid.style.display = 'none';
    ['lb-prev', 'lb-next', 'lb-counter'].forEach(id => document.getElementById(id).style.display = 'none');
    if (type === 'video') {
      vid.src = url;
      vid.style.display = 'block';
    } else {
      img.src = url;
      img.style.display = 'block';
    }
    document.getElementById('sp-lb').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function showLbItem() {
    const m = MEDIA[lbIdx];
    const img = document.getElementById('lb-img'),
      vid = document.getElementById('lb-vid');
    img.style.display = 'none';
    vid.pause();
    vid.style.display = 'none';
    if (m.type === 'video') {
      vid.src = m.url;
      vid.style.display = 'block';
    } else {
      img.src = m.url;
      img.style.display = 'block';
    }
    document.getElementById('lb-counter').textContent = `${lbIdx + 1} / ${MEDIA.length}`;
  }

  function lbStep(dir) {
    lbIdx = (lbIdx + dir + MEDIA.length) % MEDIA.length;
    showLbItem();
  }

  function closeLb() {
    document.getElementById('lb-vid').pause();
    document.getElementById('sp-lb').classList.remove('open');
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', e => {
    if (!document.getElementById('sp-lb').classList.contains('open')) return;
    if (e.key === 'Escape') closeLb();
    if (e.key === 'ArrowRight' && !lbSingle) lbStep(1);
    if (e.key === 'ArrowLeft' && !lbSingle) lbStep(-1);
  });
  document.getElementById('sp-lb').addEventListener('click', function (e) {
    if (e.target === this) closeLb();
  });

  /* ── Gallery delete confirm ───────────────── */
  let pendingDelForm = null;
  
  function confirmGalleryDelete(btn) {
  pendingDelForm = btn.closest('form');
  document.getElementById('delConfirmOverlay').classList.add('open');
}

document.getElementById('delConfirmBtn').addEventListener('click', function() {
  if (!pendingDelForm) return;
  // Re-enable submit and fire it
  pendingDelForm.onsubmit = null;
  pendingDelForm.submit();
});

  function closeDelConfirm() {
    pendingDelForm = null;
    document.getElementById('delConfirmOverlay').classList.remove('open');
  }

  document.getElementById('delConfirmOverlay').addEventListener('click', function (e) {
    if (e.target === this) closeDelConfirm();
  });

  /* ── Owner upload preview ─────────────────── */
  function ownerDrop(e) {
    e.preventDefault();
    document.getElementById('ownerDrop').classList.remove('over');
    const dt = new DataTransfer();
    Array.from(e.dataTransfer.files).slice(0, 10).forEach(f => dt.items.add(f));
    const input = document.getElementById('ownerFileInput');
    input.files = dt.files;
    ownerPreview(input.files);
  }

  function ownerPreview(files) {
    const preview = document.getElementById('ownerPreview');
    const btn = document.getElementById('ownerUploadBtn');
    const count = document.getElementById('ownerFileCount');
    preview.innerHTML = '';
    const list = Array.from(files).slice(0, 10);
    list.forEach(f => preview.appendChild(makePrevThumb(f)));
    if (list.length) {
      count.textContent = `${list.length} file${list.length !== 1 ? 's' : ''} selected`;
      btn.disabled = false;
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
    }
  }

  /* ── Review upload preview ────────────────── */
  function revDrop(e) {
    e.preventDefault();
    document.getElementById('reviewDrop').classList.remove('over');
    const dt = new DataTransfer();
    Array.from(e.dataTransfer.files).slice(0, 5).forEach(f => dt.items.add(f));
    const input = document.getElementById('reviewFileInput');
    input.files = dt.files;
    reviewPreview(input.files);
  }

  function reviewPreview(files) {
    const preview = document.getElementById('reviewPreview');
    preview.innerHTML = '';
    Array.from(files).slice(0, 5).forEach(f => preview.appendChild(makePrevThumb(f)));
  }

  function makePrevThumb(file) {
    const wrap = document.createElement('div');
    wrap.className = 'prev-thumb';
    const src = URL.createObjectURL(file);
    if (file.type.startsWith('video')) {
      const v = document.createElement('video');
      v.src = src;
      v.muted = true;
      v.style.cssText = 'width:100%;height:100%;object-fit:cover;';
      const badge = document.createElement('div');
      badge.className = 'pv-badge';
      badge.innerHTML = '<i class="fa-solid fa-play"></i>';
      wrap.append(v, badge);
    } else {
      const img = document.createElement('img');
      img.src = src;
      img.style.cssText = 'width:100%;height:100%;object-fit:cover;';
      wrap.appendChild(img);
    }
    return wrap;
  }

  /* ── Form validation ──────────────────────── */
  (function () {
    'use strict';
    document.querySelectorAll('.needs-validation').forEach(form => {
      form.addEventListener('submit', e => {
        if (!form.checkValidity()) {
          e.preventDefault();
          e.stopPropagation();
        }
        form.classList.add('was-validated');
      });
    });
  })();

  /* ── Map ──────────────────────────────────── */
  document.addEventListener('DOMContentLoaded', function () {
    const raw = document.getElementById('map-data');
    if (!raw || typeof L === 'undefined') return;
    let d;
    try {
      d = JSON.parse(raw.textContent);
    } catch (e) {
      return;
    }

    const DELHI = {
      lat: 28.6448,
      lng: 77.2167
    };
    const isFallback = (la, ln) => Math.abs(la - DELHI.lat) < 0.001 && Math.abs(ln - DELHI.lng) < 0.001;

    function renderMap(lat, lng) {
      const map = L.map('map').setView([lat, lng], 13);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19,
      }).addTo(map);
      const icon = L.divIcon({
        html: `<div style="width:18px;height:18px;border-radius:50%;background:#e8392a;border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,.4);"></div>`,
        className: '',
        iconSize: [18, 18],
        iconAnchor: [9, 9],
      });
      L.marker([lat, lng], {
          icon
        }).addTo(map)
        .bindPopup(`<strong style="font-size:.85rem;">${d.title}</strong>`).openPopup();
    }

    if (d.lat && d.lng && !isFallback(d.lat, d.lng)) {
      renderMap(d.lat, d.lng);
      return;
    }

    fetch(
        `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(d.location+', '+d.country)}&format=json&limit=1`, {
          headers: {
            'Accept-Language': 'en'
          }
        })
      .then(r => r.json())
      .then(res => {
        if (res && res.length > 0) renderMap(parseFloat(res[0].lat), parseFloat(res[0].lon));
        else renderMap(d.lat, d.lng);
      })
      .catch(() => renderMap(d.lat, d.lng));
  });
</script>