<% layout('/layouts/boiler-plate') %>

<div class="wl-show-layout">

  <!-- ════════════════════════════════
       LEFT — Listing Details
  ════════════════════════════════ -->
  <div>

    <!-- ── Hero Image ── -->
    <div class="wl-show-img-hero">
      <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
    </div>

    <!-- ── Gallery (host photos/videos) ── -->
    <% if (listing.gallery && listing.gallery.length > 0) { %>
    <div style="margin-bottom:1.5rem;">
      <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(160px,1fr)); gap:0.6rem;">
        <% for(let media of listing.gallery) { %>
        <div style="position:relative; border-radius:10px; overflow:hidden; aspect-ratio:4/3; background:#f0f0f0;">
          <% if(media.type === 'video') { %>
          <video src="<%= media.url %>" controls style="width:100%; height:100%; object-fit:cover;"></video>
          <% } else { %>
          <img src="<%= media.url %>" alt="Gallery" style="width:100%; height:100%; object-fit:cover;">
          <% } %>

          <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
          <form method="post" action="/listings/<%= listing._id %>/gallery/<%= media._id %>?_method=DELETE"
                style="position:absolute; top:0.4rem; right:0.4rem;">
            <button type="submit"
              style="width:26px;height:26px;border-radius:50%;background:rgba(0,0,0,0.55);border:none;color:white;font-size:0.7rem;cursor:pointer;display:flex;align-items:center;justify-content:center;">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </form>
          <% } %>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- ── Host: Add Gallery Media ── -->
    <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
    <div style="background:white; border-radius:var(--radius); padding:1.25rem; margin-bottom:1.5rem; box-shadow:var(--card-shadow); border:1.5px dashed var(--border);">
      <h4 style="font-size:0.9rem; font-weight:700; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.5rem;">
        <i class="fa-solid fa-images" style="color:var(--primary);"></i> Add Photos / Videos to Gallery
      </h4>
      <form method="post" action="/listings/<%= listing._id %>/gallery" enctype="multipart/form-data">
        <div style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center;">
          <input type="file" name="gallery" multiple accept="image/*,video/*"
            style="font-size:0.8rem; flex:1; min-width:0; border:1.5px solid var(--border); border-radius:8px; padding:0.45rem 0.7rem; font-family:'DM Sans',sans-serif;">
          <button type="submit" class="wl-submit-btn" style="padding:0.5rem 1.1rem; font-size:0.82rem; white-space:nowrap;">
            <i class="fa-solid fa-upload"></i> Upload
          </button>
        </div>
        <p style="font-size:0.72rem; color:var(--text-muted); margin-top:0.4rem;">
          <i class="fa-solid fa-circle-info"></i> Supports JPG, PNG, WebP, MP4, MOV. Max 10 files at once.
        </p>
      </form>
    </div>
    <% } %>

    <!-- ── Title + Actions ── -->
    <div class="wl-show-meta">
      <div>
        <h1 class="wl-show-title"><%= listing.title %></h1>
        <p style="color:var(--text-muted); font-size:0.88rem; display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
          <i class="fa-solid fa-location-dot" style="color:var(--primary);"></i>
          <%= listing.location %>, <%= listing.country %>
          &nbsp;·&nbsp;
          <i class="fa-regular fa-user"></i>
          Hosted by <strong><%= listing.owner.username %></strong>
        </p>
      </div>

      <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
      <div class="wl-show-actions">
        <form method="get" action="/listings/<%= listing._id %>/edit">
          <button type="submit" class="wl-action-btn">
            <i class="fa-regular fa-pen-to-square"></i> Edit
          </button>
        </form>
        <form method="post" action="/listings/<%= listing._id %>?_method=Delete">
          <button type="submit" class="wl-action-btn danger">
            <i class="fa-regular fa-trash-can"></i> Delete
          </button>
        </form>
      </div>
      <% } %>
    </div>

    <!-- ── Info Cards ── -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(110px,1fr)); gap:0.75rem; margin-bottom:1.5rem;">
      <div style="background:white; border-radius:10px; padding:0.9rem; text-align:center; box-shadow:var(--card-shadow);">
        <i class="fa-solid fa-indian-rupee-sign" style="font-size:1.3rem; color:var(--primary); margin-bottom:0.3rem; display:block;"></i>
        <div style="font-weight:700; color:var(--primary); font-size:1rem;">₹<%= listing.price.toLocaleString('en-IN') %></div>
        <div style="font-size:0.7rem; color:var(--text-muted);">per night</div>
      </div>
      <div style="background:white; border-radius:10px; padding:0.9rem; text-align:center; box-shadow:var(--card-shadow);">
        <i class="fa-regular fa-comment-dots" style="font-size:1.3rem; color:#7c6af5; margin-bottom:0.3rem; display:block;"></i>
        <div style="font-weight:700; font-size:1rem;"><%= listing.reviews.length %></div>
        <div style="font-size:0.7rem; color:var(--text-muted);">Reviews</div>
      </div>
      <div style="background:white; border-radius:10px; padding:0.9rem; text-align:center; box-shadow:var(--card-shadow);">
        <i class="fa-solid fa-earth-asia" style="font-size:1.3rem; color:#42a5f5; margin-bottom:0.3rem; display:block;"></i>
        <div style="font-weight:700; font-size:0.88rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= listing.country %></div>
        <div style="font-size:0.7rem; color:var(--text-muted);">Country</div>
      </div>
      <div style="background:white; border-radius:10px; padding:0.9rem; text-align:center; box-shadow:var(--card-shadow);">
        <i class="fa-solid fa-shield-halved" style="font-size:1.3rem; color:#4caf9a; margin-bottom:0.3rem; display:block;"></i>
        <div style="font-weight:700; font-size:0.88rem;">Verified</div>
        <div style="font-size:0.7rem; color:var(--text-muted);">Safe Stay</div>
      </div>
      <%
        // Real average rating from actual reviews
        const avgRating = listing.reviews.length > 0
          ? (listing.reviews.reduce((sum, r) => sum + (r.rating || 0), 0) / listing.reviews.length).toFixed(1)
          : null;
      %>
      <% if(avgRating) { %>
      <div style="background:white; border-radius:10px; padding:0.9rem; text-align:center; box-shadow:var(--card-shadow);">
        <i class="fa-solid fa-star" style="font-size:1.3rem; color:#f59e0b; margin-bottom:0.3rem; display:block;"></i>
        <div style="font-weight:700; font-size:1rem;"><%= avgRating %></div>
        <div style="font-size:0.7rem; color:var(--text-muted);">Avg Rating</div>
      </div>
      <% } %>
    </div>

    <!-- ── Description ── -->
    <div style="background:white; border-radius:var(--radius); padding:1.5rem; margin-bottom:1.5rem; box-shadow:var(--card-shadow);">
      <h3 style="font-family:'Bricolage Grotesque',sans-serif; font-size:1.05rem; font-weight:700; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.5rem;">
        <i class="fa-regular fa-file-lines" style="color:var(--primary);"></i> About this stay
      </h3>
      <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.75;"><%= listing.description %></p>
    </div>

    <!-- ── Map ── -->
    <div style="background:white; border-radius:var(--radius); padding:1.5rem; margin-bottom:1.5rem; box-shadow:var(--card-shadow);">
      <h3 style="font-family:'Bricolage Grotesque',sans-serif; font-size:1.05rem; font-weight:700; margin-bottom:0.5rem; display:flex; align-items:center; gap:0.5rem;">
        <i class="fa-solid fa-location-dot" style="color:var(--primary);"></i> Where you'll be
      </h3>
      <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:0.75rem;">
        <%= listing.location %>, <%= listing.country %>
      </p>
      <div id="map"></div>
      <script id="listing-coordinates" type="application/json">
        <%- JSON.stringify({ lat, lng, title: listing.title }) %>
      </script>
    </div>

    <!-- ── Review Form ── -->
    <% if(currUser) { %>
    <div style="background:white; border-radius:var(--radius); padding:1.5rem; margin-bottom:1.5rem; box-shadow:var(--card-shadow);">
      <h3 style="font-family:'Bricolage Grotesque',sans-serif; font-size:1.05rem; font-weight:700; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;">
        <i class="fa-regular fa-pen-to-square" style="color:var(--primary);"></i> Leave a Review
      </h3>
      <form method="post" action="/listings/<%= listing._id %>/reviews"
            class="needs-validation" novalidate enctype="multipart/form-data">

        <!-- Star Rating -->
        <div style="margin-bottom:1rem;">
          <label class="wl-form-label">Your Rating</label>
          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <!-- Comment -->
        <div style="margin-bottom:1rem;">
          <label class="wl-form-label">Comment</label>
          <textarea name="review[comment]" rows="3" class="wl-form-control" required
            placeholder="Share your experience..."></textarea>
          <div class="invalid-feedback">Please add a comment.</div>
        </div>

        <!-- Media Upload -->
        <div style="margin-bottom:1rem;">
          <label class="wl-form-label" style="display:flex; align-items:center; gap:0.4rem;">
            <i class="fa-regular fa-image" style="color:var(--primary);"></i>
            Add Photos / Videos <span style="font-weight:400; color:var(--text-muted);">(optional)</span>
          </label>
          <input type="file" name="reviewMedia" multiple accept="image/*,video/*"
            style="font-size:0.8rem; width:100%; border:1.5px solid var(--border); border-radius:8px; padding:0.45rem 0.7rem; font-family:'DM Sans',sans-serif;">
          <p style="font-size:0.72rem; color:var(--text-muted); margin-top:0.3rem;">
            Up to 5 photos or videos from your stay.
          </p>
        </div>

        <button type="submit" class="wl-submit-btn">
          <i class="fa-regular fa-paper-plane"></i> Submit Review
        </button>
      </form>
    </div>
    <% } else { %>
    <div style="background:var(--primary-soft); border-radius:var(--radius); padding:1.1rem; margin-bottom:1.5rem; border:1.5px solid rgba(232,57,42,0.2);">
      <p style="font-size:0.88rem; color:var(--primary); margin:0; display:flex; align-items:center; gap:0.5rem;">
        <i class="fa-solid fa-lock"></i>
        <a href="/login" style="color:var(--primary); font-weight:700;">Log in</a> to leave a review.
      </p>
    </div>
    <% } %>

    <!-- ── All Reviews ── -->
    <% if(listing.reviews.length > 0) { %>
    <div style="background:white; border-radius:var(--radius); padding:1.5rem; box-shadow:var(--card-shadow);">
      <h3 style="font-family:'Bricolage Grotesque',sans-serif; font-size:1.05rem; font-weight:700; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;">
        <i class="fa-regular fa-comments" style="color:var(--primary);"></i>
        Reviews
        <span style="color:var(--text-muted); font-weight:400; font-size:0.85rem;">(<%= listing.reviews.length %>)</span>
        <% if(avgRating) { %>
        <span style="margin-left:auto; font-size:0.82rem; font-weight:600; color:#f59e0b; display:flex; align-items:center; gap:0.25rem;">
          <i class="fa-solid fa-star"></i> <%= avgRating %> avg
        </span>
        <% } %>
      </h3>

      <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:0.75rem;">
        <% for(let review of listing.reviews) { %>
        <div class="wl-review-card">

          <!-- Author row -->
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.5rem;">
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;color:white;font-size:0.75rem;font-weight:700;flex-shrink:0;">
                <%= review.author.username.charAt(0).toUpperCase() %>
              </div>
              <div>
                <div style="font-size:0.82rem; font-weight:700;">@<%= review.author.username %></div>
                <div style="font-size:0.68rem; color:var(--text-muted);">
                  <%= new Date(review.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) %>
                </div>
              </div>
            </div>

            <% if(currUser && currUser._id.equals(review.author._id)) { %>
            <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=Delete">
              <button type="submit"
                style="background:none;border:none;color:var(--text-muted);font-size:0.75rem;cursor:pointer;padding:0.2rem 0.4rem;border-radius:4px;transition:color 0.2s;"
                onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-muted)'">
                <i class="fa-regular fa-trash-can"></i>
              </button>
            </form>
            <% } %>
          </div>

          <!-- Stars -->
          <p class="starability-result" data-rating="<%= review.rating %>" style="margin-bottom:0.4rem;"></p>

          <!-- Comment -->
          <p style="font-size:0.82rem; color:var(--text-muted); line-height:1.55; margin-bottom:0.5rem;">
            <%= review.comment %>
          </p>

          <!-- Review media thumbnails -->
          <% if(review.media && review.media.length > 0) { %>
          <div style="display:flex; gap:0.4rem; flex-wrap:wrap; margin-top:0.4rem;">
            <% for(let m of review.media) { %>
            <% if(m.type === 'video') { %>
            <video src="<%= m.url %>"
              style="width:72px;height:56px;object-fit:cover;border-radius:6px;cursor:pointer;"
              onclick="openMediaViewer('<%= m.url %>','video')"></video>
            <% } else { %>
            <img src="<%= m.url %>" alt="review photo"
              style="width:72px;height:56px;object-fit:cover;border-radius:6px;cursor:pointer;"
              onclick="openMediaViewer('<%= m.url %>','image')">
            <% } %>
            <% } %>
          </div>
          <% } %>

        </div>
        <% } %>
      </div>
    </div>
    <% } %>

  </div><!-- end left column -->

  <!-- ════════════════════════════════
       RIGHT — Host Card only
  ════════════════════════════════ -->
  <div>

    <!-- Price summary card (no booking button) -->
    <div class="wl-booking-card" style="margin-bottom:1rem;">
      <div class="wl-booking-price">
        ₹<%= listing.price.toLocaleString('en-IN') %> <small>/ night</small>
      </div>

      <% if(listing.reviews.length > 0) { %>
      <div style="display:flex; align-items:center; gap:0.4rem; margin-bottom:1rem; font-size:0.85rem;">
        <i class="fa-solid fa-star" style="color:#f59e0b;"></i>
        <strong><%= avgRating %></strong>
        <span style="color:var(--text-muted);">· <%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %></span>
      </div>
      <% } else { %>
      <div style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1rem;">
        <i class="fa-regular fa-star"></i> No reviews yet
      </div>
      <% } %>

      <hr style="border:none; border-top:1px solid var(--border); margin:0.75rem 0;">

      <div style="font-size:0.82rem; color:var(--text-muted); display:flex; justify-content:space-between; margin-bottom:0.4rem;">
        <span>Base price / night</span>
        <span>₹<%= listing.price.toLocaleString('en-IN') %></span>
      </div>
      <div style="font-size:0.82rem; color:var(--text-muted); display:flex; justify-content:space-between; margin-bottom:0.4rem;">
        <span>GST (18%)</span>
        <span>₹<%= Math.floor(listing.price * 0.18).toLocaleString('en-IN') %></span>
      </div>
      <hr style="border:none; border-top:1px solid var(--border); margin:0.75rem 0;">
      <div style="font-size:0.88rem; font-weight:700; display:flex; justify-content:space-between;">
        <span>Total / night</span>
        <span>₹<%= Math.floor(listing.price * 1.18).toLocaleString('en-IN') %></span>
      </div>

      <p style="font-size:0.72rem; color:var(--text-muted); margin-top:0.75rem; text-align:center;">
        <i class="fa-solid fa-circle-info"></i> Price includes 18% GST
      </p>
    </div>

    <!-- Host card -->
    <div style="background:white; border-radius:var(--radius); padding:1.25rem; box-shadow:var(--card-shadow);">
      <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
        <div style="width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:1.1rem;flex-shrink:0;">
          <%= listing.owner.username.charAt(0).toUpperCase() %>
        </div>
        <div>
          <div style="font-weight:700; font-size:0.9rem;">Hosted by <%= listing.owner.username %></div>
          <div style="font-size:0.75rem; color:var(--text-muted);">Wanderlust Host</div>
        </div>
      </div>
      <div style="display:flex; gap:0.75rem; flex-wrap:wrap; font-size:0.78rem; color:var(--text-muted);">
        <span><i class="fa-solid fa-shield-halved" style="color:#4caf9a;"></i> Verified host</span>
        <span><i class="fa-regular fa-comment-dots" style="color:#7c6af5;"></i> <%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %></span>
      </div>
    </div>

  </div><!-- end right column -->

</div><!-- end wl-show-layout -->

<!-- ── Media Lightbox ── -->
<div id="mediaViewerOverlay"
  style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.9);z-index:9999;align-items:center;justify-content:center;"
  onclick="closeMediaViewer()">
  <button onclick="closeMediaViewer()" style="position:absolute;top:1rem;right:1.25rem;background:none;border:none;color:white;font-size:1.5rem;cursor:pointer;">
    <i class="fa-solid fa-xmark"></i>
  </button>
  <img id="mediaViewerImg" src="" alt="" style="max-width:90vw;max-height:85vh;border-radius:10px;display:none;">
  <video id="mediaViewerVid" src="" controls style="max-width:90vw;max-height:85vh;border-radius:10px;display:none;"></video>
</div>

<script>
// ── Form validation ──────────────────────────────────
(function() {
  'use strict';
  document.querySelectorAll('.needs-validation').forEach(form => {
    form.addEventListener('submit', e => {
      if (!form.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
      form.classList.add('was-validated');
    });
  });
})();

// ── Map init ─────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function() {
  const raw = document.getElementById('listing-coordinates');
  if (!raw) return;
  try {
    const { lat, lng, title } = JSON.parse(raw.textContent);
    if (typeof L === 'undefined') return;
    const map = L.map('map').setView([lat, lng], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);
    L.marker([lat, lng])
      .addTo(map)
      .bindPopup(`<strong>${title}</strong>`)
      .openPopup();
  } catch(e) {
    console.error('Map init failed:', e);
  }
});

// ── Lightbox ─────────────────────────────────────────
function openMediaViewer(url, type) {
  const overlay = document.getElementById('mediaViewerOverlay');
  const img = document.getElementById('mediaViewerImg');
  const vid = document.getElementById('mediaViewerVid');
  img.style.display = 'none';
  vid.style.display = 'none';
  if (type === 'video') {
    vid.src = url;
    vid.style.display = 'block';
  } else {
    img.src = url;
    img.style.display = 'block';
  }
  overlay.style.display = 'flex';
}
function closeMediaViewer() {
  const overlay = document.getElementById('mediaViewerOverlay');
  document.getElementById('mediaViewerVid').pause();
  overlay.style.display = 'none';
}
</script>
