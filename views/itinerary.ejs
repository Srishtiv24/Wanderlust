<% layout('/layouts/boiler-plate') -%>

<style>
/* ── ITINERARY PAGE ─────────────────────────────────────────── */
.itin-page { max-width: 860px; margin: 0 auto; padding: 2.5rem 1.5rem 5rem; }

/* HERO */
.itin-hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2d50 100%);
  border-radius: 20px; padding: 2.5rem 2.5rem;
  display: flex; align-items: center; gap: 2rem;
  margin-bottom: 2rem; position: relative; overflow: hidden;
}
.itin-hero::before {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at top right, rgba(254,66,77,0.15), transparent 60%);
  pointer-events: none;
}
.itin-hero-icon {
  width: 64px; height: 64px; border-radius: 18px;
  background: rgba(254,66,77,0.2); border: 1.5px solid rgba(254,66,77,0.35);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  color: #ff8a70; font-size: 1.6rem;
}
.itin-hero-text { flex: 1; }
.itin-eyebrow {
  font-size: .72rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .12em; color: rgba(255,255,255,.45); margin-bottom: .4rem;
  display: flex; align-items: center; gap: .4rem;
}
.itin-eyebrow i { color: #ff8a70; }
.itin-hero h1 {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700;
  color: #fff; line-height: 1.2; margin-bottom: .5rem;
}
.itin-hero h1 span { color: #ff8a70; }
.itin-hero p { font-size: .875rem; color: rgba(255,255,255,.6); line-height: 1.6; }

/* ── OR DIVIDER ── */
.itin-or-divider {
  display: flex; align-items: center; gap: 1rem;
  margin: 1.75rem 0; color: var(--text-muted); font-size: .8rem; font-weight: 600;
}
.itin-or-divider::before, .itin-or-divider::after {
  content: ''; flex: 1; height: 1px; background: var(--border);
}

/* ── TRIP BUILDER ── */
.tb-card {
  background: #fff; border-radius: 20px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.08); overflow: hidden;
}
.tb-header { padding: 1.5rem 2rem 0; }
.tb-title {
  font-family: "Bricolage Grotesque", sans-serif;
  font-size: 1.05rem; font-weight: 700; color: var(--text);
  display: flex; align-items: center; gap: .5rem; margin-bottom: .3rem;
}
.tb-title i { color: var(--primary); }
.tb-subtitle { font-size: .82rem; color: var(--text-muted); margin-bottom: 1.25rem; }
.tb-body { display: flex; gap: 0; min-height: 400px; }
.tb-picker {
  width: 270px; flex-shrink: 0; border-right: 1px solid var(--border);
  display: flex; flex-direction: column;
}
.tb-picker-search {
  padding: .75rem 1rem; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: .5rem;
}
.tb-picker-search i { color: #aaa; font-size: .82rem; }
.tb-picker-search input {
  flex: 1; border: none; outline: none; font-size: .82rem;
  font-family: "DM Sans", sans-serif; color: var(--text); background: transparent;
}
.tb-listing-list {
  flex: 1; overflow-y: auto; padding: .5rem;
  display: flex; flex-direction: column; gap: .3rem;
  scrollbar-width: thin;
}
.tb-listing-item {
  display: flex; align-items: center; gap: .6rem;
  padding: .5rem .6rem; border-radius: 10px; border: 1.5px solid var(--border);
  cursor: grab; background: #fff; transition: all .15s; user-select: none; font-size: .78rem;
}
.tb-listing-item:hover { border-color: var(--primary); background: var(--primary-soft); }
.tb-listing-item.added { opacity: .4; cursor: not-allowed; border-style: dashed; }
.tb-listing-img { width: 36px; height: 36px; border-radius: 7px; object-fit: cover; flex-shrink: 0; }
.tb-listing-info { flex: 1; min-width: 0; }
.tb-listing-name { font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tb-listing-loc { font-size: .7rem; color: var(--text-muted); }
.tb-listing-price { font-size: .7rem; font-weight: 700; color: var(--primary); white-space: nowrap; }
.tb-drag-hint {
  font-size: .7rem; color: var(--text-muted); text-align: center;
  padding: .5rem; display: flex; align-items: center; justify-content: center; gap: .25rem;
}
.tb-canvas { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.tb-canvas-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: .65rem 1.1rem; border-bottom: 1px solid var(--border);
  gap: .5rem; flex-wrap: wrap;
}
.tb-days-control { display: flex; align-items: center; gap: .5rem; }
.tb-days-label { font-size: .78rem; font-weight: 700; color: var(--text); }
.tb-day-adj {
  width: 24px; height: 24px; border-radius: 6px; border: 1.5px solid var(--border);
  background: white; cursor: pointer; font-size: .85rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center; color: var(--text); transition: all .15s;
}
.tb-day-adj:hover { border-color: var(--primary); color: var(--primary); }
.tb-days-count { font-size: .9rem; font-weight: 700; color: var(--primary); min-width: 18px; text-align: center; }
.tb-canvas-actions { display: flex; gap: .35rem; }
.tb-action-btn {
  padding: .35rem .75rem; border-radius: 8px; font-size: .75rem; font-weight: 700;
  font-family: "DM Sans", sans-serif; cursor: pointer; transition: all .15s;
  display: flex; align-items: center; gap: .3rem;
  border: 1.5px solid var(--border); background: white; color: var(--text);
}
.tb-action-btn:hover { border-color: var(--primary); color: var(--primary); }
.tb-action-btn.primary { background: var(--primary); color: white; border-color: var(--primary); }
.tb-action-btn.primary:hover { background: #c62f22; }
.tb-days-scroll {
  flex: 1; overflow-y: auto; padding: .85rem 1.1rem;
  display: flex; flex-direction: column; gap: .75rem;
  scrollbar-width: thin;
}
.tb-day-col { border-radius: 12px; border: 1.5px solid var(--border); overflow: hidden; }
.tb-day-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: .5rem .8rem; background: #fafafa; border-bottom: 1px solid var(--border);
}
.tb-day-label { font-size: .78rem; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: .4rem; }
.tb-day-num {
  width: 20px; height: 20px; border-radius: 5px;
  background: var(--primary); color: white;
  font-size: .68rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.tb-day-count { font-size: .7rem; color: var(--text-muted); }
.tb-clear-day {
  font-size: .7rem; color: var(--text-muted); cursor: pointer;
  border: none; background: none; padding: .12rem .35rem; border-radius: 4px; transition: color .15s;
}
.tb-clear-day:hover { color: var(--primary); }
.tb-drop-zone {
  min-height: 68px; padding: .45rem;
  display: flex; flex-direction: column; gap: .3rem; transition: background .2s;
}
.tb-drop-zone.drag-over { background: rgba(254,66,77,0.06); }
.tb-drop-zone.empty::before {
  content: "Drop listings here";
  display: flex; align-items: center; justify-content: center;
  height: 52px; border: 2px dashed var(--border); border-radius: 8px;
  color: var(--text-muted); font-size: .76rem; font-weight: 600;
  width: 100%; box-sizing: border-box;
}
.tb-drop-zone.drag-over.empty::before { border-color: var(--primary); color: var(--primary); }
.tb-placed-card {
  display: flex; align-items: center; gap: .55rem;
  padding: .4rem .55rem; border-radius: 8px;
  background: white; border: 1.5px solid var(--border);
  font-size: .76rem; cursor: grab; user-select: none; transition: all .15s;
}
.tb-placed-card:hover { border-color: var(--primary); box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
.tb-placed-img { width: 30px; height: 30px; border-radius: 6px; object-fit: cover; flex-shrink: 0; }
.tb-placed-name { flex: 1; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tb-placed-loc { font-size: .68rem; color: var(--text-muted); }
.tb-placed-price { font-size: .68rem; font-weight: 700; color: var(--primary); white-space: nowrap; }
.tb-remove-btn {
  width: 18px; height: 18px; border-radius: 50%; border: none;
  background: #f5f5f5; color: #999; cursor: pointer; font-size: .65rem;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all .15s;
}
.tb-remove-btn:hover { background: #fee; color: var(--primary); }
.tb-generate-bar {
  padding: .85rem 1.1rem; border-top: 1px solid var(--border);
  background: #fafafa; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
}
.tb-summary-text { font-size: .78rem; color: var(--text-muted); }
.tb-summary-text strong { color: var(--text); }
.tb-gen-btn {
  padding: .5rem 1.1rem; background: var(--primary); color: white;
  border: none; border-radius: 10px; font-size: .8rem; font-weight: 700;
  font-family: "DM Sans", sans-serif; cursor: pointer; transition: all .2s;
  display: flex; align-items: center; gap: .4rem;
}
.tb-gen-btn:hover { background: #c62f22; }
.tb-gen-btn:disabled { opacity: .5; cursor: not-allowed; }
@media(max-width: 680px) {
  .tb-body { flex-direction: column; }
  .tb-picker { width: 100%; border-right: none; border-bottom: 1px solid var(--border); max-height: 220px; }
}

/* FORM CARD */
.itin-form-card {
  background: #fff; border-radius: 20px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.08); padding: 2rem;
}
.itin-form-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 1.05rem; font-weight: 700; color: var(--text);
  margin-bottom: 1.5rem; display: flex; align-items: center; gap: .5rem;
}
.itin-form-title i { color: var(--primary); }

/* Section dividers inside form */
.itin-section-label {
  font-size: .7rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .1em; color: var(--text-muted);
  margin: 1.5rem 0 .75rem; display: flex; align-items: center; gap: .5rem;
  padding-bottom: .5rem; border-bottom: 1px solid var(--border);
}
.itin-section-label i { color: var(--primary); font-size: .75rem; }

.itin-form-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: .85rem;
}
@media(max-width: 600px) { .itin-form-grid { grid-template-columns: 1fr; } }

.itin-form-group { display: flex; flex-direction: column; gap: .3rem; }
.itin-form-group.full { grid-column: 1 / -1; }
.itin-form-group.third { grid-column: span 1; }

.itin-label {
  font-size: .78rem; font-weight: 600; color: var(--text);
  display: flex; align-items: center; gap: .35rem;
}
.itin-label i { color: var(--primary); width: 14px; text-align: center; font-size: .75rem; }
.itin-label .req { color: var(--primary); }

.itin-input {
  padding: .6rem .85rem; border: 1.5px solid var(--border);
  border-radius: 10px; font-size: .875rem; font-family: 'DM Sans', sans-serif;
  color: var(--text); background: #fff; outline: none; transition: border-color .2s, box-shadow .2s;
}
.itin-input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(232,57,42,.08); }
.itin-input::placeholder { color: #bbb; }
select.itin-input { cursor: pointer; }

/* Checkbox toggle group */
.itin-check-group {
  display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .15rem;
}
.itin-check-pill {
  display: flex; align-items: center; gap: .4rem;
  padding: .38rem .8rem; border-radius: 50px;
  border: 1.5px solid var(--border); font-size: .78rem; font-weight: 600;
  cursor: pointer; background: #fff; color: var(--text);
  transition: all .18s; user-select: none;
}
.itin-check-pill i { font-size: .72rem; color: var(--text-muted); transition: color .18s; }
.itin-check-pill.sel {
  border-color: var(--primary); background: var(--primary-soft); color: var(--primary);
}
.itin-check-pill.sel i { color: var(--primary); }

/* Generate button */
.itin-gen-btn {
  width: 100%; padding: .85rem; background: var(--primary); color: #fff;
  border: none; border-radius: 12px; font-size: .95rem; font-weight: 700;
  font-family: 'DM Sans', sans-serif; cursor: pointer; transition: all .2s;
  display: flex; align-items: center; justify-content: center; gap: .5rem;
  margin-top: 1.5rem; letter-spacing: .01em;
}
.itin-gen-btn:hover:not(:disabled) { background: #c62f22; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(232,57,42,0.25); }
.itin-gen-btn:disabled { opacity: .6; cursor: not-allowed; transform: none; }
.itin-gen-btn i { font-size: 1rem; }
</style>

<div class="itin-page">

  <!-- HERO -->
  <div class="itin-hero">
    <div class="itin-hero-icon">
      <i class="fa-solid fa-plane-departure"></i>
    </div>
    <div class="itin-hero-text">
      <div class="itin-eyebrow">
        <i class="fa-solid fa-wand-magic-sparkles"></i> AI-Powered &nbsp;·&nbsp; Personalised
      </div>
      <h1>Your perfect trip,<br><span>planned in seconds</span></h1>
      <p>Fill in your preferences and our AI builds a complete day-by-day itinerary with local food picks, hidden gems, insider tips and estimated costs.</p>
    </div>
  </div>

  <!-- TRIP BUILDER -->
  <div class="tb-card">
    <div class="tb-header">
      <div class="tb-title">
        <i class="fa-solid fa-layer-group"></i> Visual Trip Builder
        <span style="font-size:.68rem; font-weight:600; color:white; background:var(--primary); padding:.12rem .55rem; border-radius:20px; margin-left:.25rem;">NEW</span>
      </div>
      <p class="tb-subtitle">Drag listings from your favourites into day slots to build your trip visually — then let AI fill in the details.</p>
    </div>

    <div class="tb-body">
      <!-- LEFT: Listing picker -->
      <div class="tb-picker">
        <div class="tb-picker-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="tbSearch" placeholder="Search listings…" oninput="tbFilterListings(this.value)">
        </div>
        <div class="tb-listing-list" id="tbListingList">
          <!-- Populated by JS from /api/listings-by-ids or all listings -->
          <div style="padding:1rem; font-size:.78rem; color:var(--text-muted); text-align:center;">
            <i class="fa-solid fa-circle-notch fa-spin" style="display:block; margin-bottom:.5rem; font-size:1.2rem;"></i>
            Loading listings…
          </div>
        </div>
        <div class="tb-drag-hint">
          <i class="fa-solid fa-hand-pointer"></i> Drag a listing into a day
        </div>
      </div>

      <!-- RIGHT: Canvas -->
      <div class="tb-canvas">
        <div class="tb-canvas-toolbar">
          <div class="tb-days-control">
            <span class="tb-days-label"><i class="fa-regular fa-calendar"></i> Days:</span>
            <button class="tb-day-adj" onclick="tbAdjDays(-1)">−</button>
            <span class="tb-days-count" id="tbDaysCount">3</span>
            <button class="tb-day-adj" onclick="tbAdjDays(1)">+</button>
          </div>
          <div class="tb-canvas-actions">
            <button class="tb-action-btn" onclick="tbClearAll()">
              <i class="fa-solid fa-trash"></i> Clear
            </button>
            <button class="tb-action-btn" onclick="tbSaveLocal()">
              <i class="fa-solid fa-floppy-disk"></i> Save
            </button>
          </div>
        </div>

        <div class="tb-days-scroll" id="tbDaysScroll">
          <!-- Day columns rendered by JS -->
        </div>

        <div class="tb-generate-bar">
          <div class="tb-summary-text" id="tbSummaryText">
            Add listings to days above, then generate your AI itinerary.
          </div>
          <button class="tb-gen-btn" id="tbGenBtn" onclick="tbGenerateFromBuilder()" disabled>
            <i class="fa-solid fa-wand-magic-sparkles"></i> Generate with AI
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- OR DIVIDER -->
  <div class="itin-or-divider">OR fill in the form below</div>

  <!-- FORM -->
  <div class="itin-form-card">
    <div class="itin-form-title">
      <i class="fa-solid fa-route"></i> Trip Details
    </div>

    <!-- Section: Where & When -->
    <div class="itin-section-label">
      <i class="fa-solid fa-location-dot"></i> Where &amp; When
    </div>
    <div class="itin-form-grid">
      <div class="itin-form-group full">
        <label class="itin-label">
          <i class="fa-solid fa-map-pin"></i> Destination <span class="req">*</span>
        </label>
        <input type="text" id="itinDestination" class="itin-input"
               placeholder="e.g. Coorg, Karnataka  or  Spiti Valley, Himachal">
      </div>

      <div class="itin-form-group">
        <label class="itin-label">
          <i class="fa-regular fa-calendar"></i> Start Date
        </label>
        <input type="date" id="itinStartDate" class="itin-input">
      </div>

      <div class="itin-form-group">
        <label class="itin-label">
          <i class="fa-solid fa-moon"></i> Trip Duration <span class="req">*</span>
        </label>
        <select id="itinDays" class="itin-input">
          <option value="1">1 Day</option>
          <option value="2">2 Days</option>
          <option value="3" selected>3 Days</option>
          <option value="4">4 Days</option>
          <option value="5">5 Days</option>
          <option value="7">7 Days</option>
          <option value="10">10 Days</option>
          <option value="14">2 Weeks</option>
        </select>
      </div>
    </div>

    <!-- Section: Who & How -->
    <div class="itin-section-label">
      <i class="fa-solid fa-users"></i> Who &amp; How
    </div>
    <div class="itin-form-grid">
      <div class="itin-form-group">
        <label class="itin-label">
          <i class="fa-solid fa-person"></i> Travelling as
        </label>
        <select id="itinGroup" class="itin-input">
          <option value="a solo traveller">Solo</option>
          <option value="a couple" selected>Couple</option>
          <option value="a family with kids">Family with Kids</option>
          <option value="a group of friends">Friends Group</option>
          <option value="a corporate group">Corporate Group</option>
        </select>
      </div>

      <div class="itin-form-group">
        <label class="itin-label">
          <i class="fa-solid fa-people-group"></i> Group Size
        </label>
        <input type="number" id="itinGroupSize" class="itin-input"
               placeholder="e.g. 2" min="1" max="50" value="2">
      </div>

      <div class="itin-form-group">
        <label class="itin-label">
          <i class="fa-solid fa-indian-rupee-sign"></i> Budget per day
        </label>
        <select id="itinBudget" class="itin-input">
          <option value="budget (under ₹1500/day)">Budget — under ₹1500/day</option>
          <option value="moderate (₹1500–4000/day)" selected>Moderate — ₹1500–4000/day</option>
          <option value="comfortable (₹4000–8000/day)">Comfortable — ₹4000–8000/day</option>
          <option value="luxury (₹8000+/day)">Luxury — ₹8000+/day</option>
        </select>
      </div>

      <div class="itin-form-group">
        <label class="itin-label">
          <i class="fa-solid fa-car"></i> Transport preference
        </label>
        <select id="itinTransport" class="itin-input">
          <option value="any transport">Any / Flexible</option>
          <option value="public transport only">Public Transport</option>
          <option value="self-drive / rental car">Self-Drive / Rental</option>
          <option value="cab / taxi">Cab / Taxi</option>
          <option value="bike / scooter">Bike / Scooter</option>
          <option value="train">Train</option>
          <option value="flight + local transport">Flight + Local</option>
        </select>
      </div>
    </div>

    <!-- Section: Preferences -->
    <div class="itin-section-label">
      <i class="fa-solid fa-sliders"></i> Preferences
    </div>
    <div class="itin-form-grid">
      <div class="itin-form-group full">
        <label class="itin-label">
          <i class="fa-solid fa-compass"></i> Interests &amp; Activities
        </label>
        <input type="text" id="itinInterests" class="itin-input"
               placeholder="e.g. trekking, local food, photography, temples, waterfalls, markets…">
      </div>

      <div class="itin-form-group full">
        <label class="itin-label">
          <i class="fa-solid fa-utensils"></i> Food preferences
        </label>
        <input type="text" id="itinFood" class="itin-input"
               placeholder="e.g. vegetarian, street food lover, seafood, South Indian, no spice…">
      </div>

      <div class="itin-form-group full">
        <label class="itin-label">
          <i class="fa-solid fa-star"></i> Must-see or special requests
        </label>
        <input type="text" id="itinMustSee" class="itin-input"
               placeholder="e.g. must visit a waterfall, want a sunrise hike, anniversary dinner…">
      </div>

      <!-- Travel Style pills -->
      <div class="itin-form-group full">
        <label class="itin-label">
          <i class="fa-solid fa-wand-magic-sparkles"></i> Travel Style <span style="color:#aaa; font-weight:400; font-size:.72rem;">(pick any)</span>
        </label>
        <div class="itin-check-group">
          <span class="itin-check-pill" data-val="relaxed" onclick="togglePill(this)">
            <i class="fa-solid fa-mug-hot"></i> Relaxed
          </span>
          <span class="itin-check-pill" data-val="adventurous" onclick="togglePill(this)">
            <i class="fa-solid fa-person-hiking"></i> Adventurous
          </span>
          <span class="itin-check-pill" data-val="cultural" onclick="togglePill(this)">
            <i class="fa-solid fa-landmark"></i> Cultural
          </span>
          <span class="itin-check-pill" data-val="offbeat" onclick="togglePill(this)">
            <i class="fa-solid fa-gem"></i> Offbeat
          </span>
          <span class="itin-check-pill" data-val="romantic" onclick="togglePill(this)">
            <i class="fa-solid fa-heart"></i> Romantic
          </span>
          <span class="itin-check-pill" data-val="family-friendly" onclick="togglePill(this)">
            <i class="fa-solid fa-children"></i> Family-friendly
          </span>
          <span class="itin-check-pill" data-val="spiritual" onclick="togglePill(this)">
            <i class="fa-solid fa-om"></i> Spiritual
          </span>
          <span class="itin-check-pill" data-val="luxury" onclick="togglePill(this)">
            <i class="fa-solid fa-crown"></i> Luxury
          </span>
        </div>
      </div>

      <!-- Pace pills -->
      <div class="itin-form-group full">
        <label class="itin-label">
          <i class="fa-solid fa-gauge"></i> Trip Pace
        </label>
        <div class="itin-check-group" id="paceGroup">
          <span class="itin-check-pill" data-val="slow-paced" onclick="toggleSingle(this, 'paceGroup')">
            <i class="fa-solid fa-feather"></i> Slow &amp; Easy
          </span>
          <span class="itin-check-pill sel" data-val="balanced" onclick="toggleSingle(this, 'paceGroup')">
            <i class="fa-solid fa-scale-balanced"></i> Balanced
          </span>
          <span class="itin-check-pill" data-val="packed" onclick="toggleSingle(this, 'paceGroup')">
            <i class="fa-solid fa-bolt"></i> Packed
          </span>
        </div>
      </div>

      <!-- Accommodation pills -->
      <div class="itin-form-group full">
        <label class="itin-label">
          <i class="fa-solid fa-bed"></i> Accommodation Type
        </label>
        <div class="itin-check-group" id="accomGroup">
          <span class="itin-check-pill" data-val="hostel" onclick="togglePill(this)">
            <i class="fa-solid fa-building"></i> Hostel
          </span>
          <span class="itin-check-pill" data-val="guesthouse" onclick="togglePill(this)">
            <i class="fa-solid fa-house"></i> Guesthouse
          </span>
          <span class="itin-check-pill sel" data-val="hotel" onclick="togglePill(this)">
            <i class="fa-solid fa-hotel"></i> Hotel
          </span>
          <span class="itin-check-pill" data-val="resort" onclick="togglePill(this)">
            <i class="fa-solid fa-umbrella-beach"></i> Resort
          </span>
          <span class="itin-check-pill" data-val="homestay" onclick="togglePill(this)">
            <i class="fa-solid fa-hand-holding-heart"></i> Homestay
          </span>
          <span class="itin-check-pill" data-val="camping" onclick="togglePill(this)">
            <i class="fa-solid fa-campground"></i> Camping
          </span>
        </div>
      </div>
    </div>

    <button class="itin-gen-btn" id="generateBtn" onclick="generateItinerary()">
      <i class="fa-solid fa-wand-magic-sparkles"></i> Generate My Itinerary
    </button>
  </div>

</div>

<script>
// ── Multi-select pills (any number) ──
function togglePill(el) {
  el.classList.toggle('sel');
}

// ── Single-select pills (only one at a time in a group) ──
function toggleSingle(el, groupId) {
  document.querySelectorAll(`#${groupId} .itin-check-pill`).forEach(p => p.classList.remove('sel'));
  el.classList.add('sel');
}

// ── Set today as default start date ──
(function() {
  const today = new Date().toISOString().split('T')[0];
  document.getElementById('itinStartDate').value = today;

  // Pre-fill destination from ?destination= query param
  const params = new URLSearchParams(window.location.search);
  const dest   = params.get('destination');
  if (dest) document.getElementById('itinDestination').value = dest;
})();

// ── Build prompt and send to AI assistant ──
function generateItinerary() {
  const destination = document.getElementById('itinDestination').value.trim();
  const days        = document.getElementById('itinDays').value;
  const startDate   = document.getElementById('itinStartDate').value;
  const budget      = document.getElementById('itinBudget').value;
  const groupType   = document.getElementById('itinGroup').value;
  const groupSize   = document.getElementById('itinGroupSize').value;
  const transport   = document.getElementById('itinTransport').value;
  const interests   = document.getElementById('itinInterests').value.trim();
  const food        = document.getElementById('itinFood').value.trim();
  const mustSee     = document.getElementById('itinMustSee').value.trim();

  // collect multi-select pills
  const styles = [...document.querySelectorAll('.itin-check-pill.sel[data-val]')]
    .filter(el => !el.closest('#paceGroup') && !el.closest('#accomGroup'))
    .map(el => el.dataset.val);

  const pace   = document.querySelector('#paceGroup .itin-check-pill.sel')?.dataset.val || 'balanced';
  const accom  = [...document.querySelectorAll('#accomGroup .itin-check-pill.sel')]
    .map(el => el.dataset.val);

  if (!destination) {
    const input = document.getElementById('itinDestination');
    input.focus();
    input.style.borderColor = 'var(--primary)';
    input.placeholder = 'Please enter a destination first!';
    return;
  }

  // Build detailed natural-language prompt
  let prompt = `Plan a ${days}-day trip to ${destination}`;
  if (startDate) prompt += ` starting ${startDate}`;
  prompt += ` for ${groupType}`;
  if (groupSize) prompt += ` (${groupSize} people)`;
  prompt += ` on a ${budget} budget.`;

  if (transport && transport !== 'any transport') prompt += ` Preferred transport: ${transport}.`;
  if (styles.length)  prompt += ` Travel style: ${styles.join(', ')}.`;
  if (pace)           prompt += ` Trip pace: ${pace}.`;
  if (accom.length)   prompt += ` Preferred accommodation: ${accom.join(', ')}.`;
  if (interests)      prompt += ` Interests: ${interests}.`;
  if (food)           prompt += ` Food preferences: ${food}.`;
  if (mustSee)        prompt += ` Must-see or special requests: ${mustSee}.`;

  prompt += ` Provide a detailed day-by-day itinerary with morning, afternoon and evening activities, specific restaurant and food recommendations, hidden gems, estimated costs in INR, and practical travel tips.`;

  // Disable button to prevent double-click
  const btn = document.getElementById('generateBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Sending to AI…';

  window.location.href = '/ai-assistant?prompt=' + encodeURIComponent(prompt);
}

// ═══════════════════════════════════════════
// TRIP BUILDER
// ═══════════════════════════════════════════
let tbDays = 3;
let tbPlan = {}; // { day1: [listing, ...], day2: [...] }
let tbAllListings = [];
let tbDragItem = null; // { listing, fromDay } — null means from picker


  try {
    const res  = await fetch('/api/listings-by-ids?ids=all');
    // fallback: fetch all listings via a general endpoint
    // We use the public listings index via a simple fetch
    const res2 = await fetch('/listings?format=json').catch(() => null);

    // Since we don't have a JSON endpoint, load from the page's own listing data if available
    // OR fetch from a simple endpoint. We'll use the /api/listings-by-ids workaround:
    // Actually call Listing.find via a new route — for now populate from known sample data
    // by fetching /api/tb-listings we add below. Fallback: use empty with message.
    tbRenderList(tbAllListings);
  } catch(e) {
    console.warn('[TripBuilder] Could not load listings:', e);
  }

  // Load from server
  tbFetchListings();

  // Restore from localStorage
  const saved = localStorage.getItem('wl_tb_plan');
  if (saved) {
    try {
      const parsed = JSON.parse(saved);
      tbDays = parsed.days || 3;
      tbPlan = parsed.plan || {};
    } catch(e) {}
  }

  tbRenderCanvas();
}

async function tbInit() {
  // Restore saved plan from localStorage
  const saved = localStorage.getItem('wl_tb_plan');
  if (saved) {
    try {
      const parsed = JSON.parse(saved);
      tbDays = parsed.days || 3;
      tbPlan = parsed.plan || {};
    } catch(e) {}
  }

  tbRenderCanvas();

  // ✅ Load listings from correct endpoint
  tbFetchListings();
}
async function tbFetchListings() {
  try {
    const res  = await fetch('/api/tb-listings');
    const data = await res.json();
    tbAllListings = data.listings || [];
    tbRenderList(tbAllListings);
  } catch(e) {
    document.getElementById('tbListingList').innerHTML =
      '<div style="padding:1rem;font-size:.78rem;color:var(--text-muted);text-align:center;">Could not load listings.<br>Please refresh.</div>';
  }
}

// ── Render listing picker ──
function tbRenderList(listings) {
  const container = document.getElementById('tbListingList');
  if (!listings.length) {
    container.innerHTML = '<div style="padding:1rem;font-size:.78rem;color:var(--text-muted);text-align:center;">No listings found.</div>';
    return;
  }

  const placed = tbGetAllPlacedIds();
  container.innerHTML = listings.map(l => {
    const isAdded = placed.has(l._id);
    return `<div
      class="tb-listing-item${isAdded ? ' added' : ''}"
      data-id="${l._id}"
      draggable="${!isAdded}"
      ondragstart="tbDragStartPicker(event, '${l._id}')"
      title="${l.title} — ${l.location}, ${l.country}"
    >
      <img class="tb-listing-img" src="${l.image?.url || ''}" alt="" onerror="this.style.display='none'">
      <div class="tb-listing-info">
        <div class="tb-listing-name">${l.title}</div>
        <div class="tb-listing-loc"><i class="fa-solid fa-location-dot" style="font-size:.6rem;color:var(--primary);"></i> ${l.location}, ${l.country}</div>
      </div>
      <div class="tb-listing-price">₹${(l.price||0).toLocaleString('en-IN')}</div>
    </div>`;
  }).join('');
}

function tbFilterListings(q) {
  const filtered = q
    ? tbAllListings.filter(l =>
        l.title.toLowerCase().includes(q.toLowerCase()) ||
        l.location.toLowerCase().includes(q.toLowerCase()) ||
        l.country.toLowerCase().includes(q.toLowerCase()))
    : tbAllListings;
  tbRenderList(filtered);
}

function tbGetAllPlacedIds() {
  const ids = new Set();
  Object.values(tbPlan).forEach(day => day.forEach(l => ids.add(l._id)));
  return ids;
}

// ── Render canvas days ──
function tbRenderCanvas() {
  document.getElementById('tbDaysCount').textContent = tbDays;
  const scroll = document.getElementById('tbDaysScroll');

  scroll.innerHTML = Array.from({length: tbDays}, (_, i) => {
    const key     = `day${i+1}`;
    const items   = tbPlan[key] || [];
    const isEmpty = items.length === 0;

    const cards = items.map((l, idx) => `
      <div class="tb-placed-card"
        draggable="true"
        data-id="${l._id}"
        data-day="${key}"
        ondragstart="tbDragStartPlaced(event, '${l._id}', '${key}')"
      >
        <img class="tb-placed-img" src="${l.image?.url || ''}" alt="" onerror="this.style.display='none'">
        <div style="flex:1;min-width:0;">
          <div class="tb-placed-name">${l.title}</div>
          <div class="tb-placed-loc">${l.location}, ${l.country}</div>
        </div>
        <div class="tb-placed-price">₹${(l.price||0).toLocaleString('en-IN')}</div>
        <button class="tb-remove-btn" onclick="tbRemove('${key}', '${l._id}')" title="Remove">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>`).join('');

    return `
      <div class="tb-day-col" id="col-day${i+1}">
        <div class="tb-day-head">
          <div class="tb-day-label">
            <div class="tb-day-num">${i+1}</div>
            Day ${i+1}
          </div>
          <div style="display:flex;align-items:center;gap:.5rem;">
            <span class="tb-day-count">${items.length} stop${items.length !== 1 ? 's' : ''}</span>
            <button class="tb-clear-day" onclick="tbClearDay('${key}')"><i class="fa-solid fa-xmark"></i></button>
          </div>
        </div>
        <div class="tb-drop-zone${isEmpty ? ' empty' : ''}"
          id="zone-${key}"
          ondragover="tbDragOver(event)"
          ondragleave="tbDragLeave(event)"
          ondrop="tbDrop(event, '${key}')"
        >${cards}</div>
      </div>`;
  }).join('');

  tbUpdateSummary();
  tbRenderList(tbAllListings); // refresh added state
}

function tbUpdateSummary() {
  const totalStops = Object.values(tbPlan).reduce((s, d) => s + d.length, 0);
  const totalCost  = Object.values(tbPlan).flat().reduce((s, l) => s + (l.price || 0), 0);
  const btn = document.getElementById('tbGenBtn');
  const txt = document.getElementById('tbSummaryText');

  if (totalStops === 0) {
    txt.innerHTML = 'Add listings to days above, then generate your AI itinerary.';
    btn.disabled = true;
  } else {
    txt.innerHTML = `<strong>${totalStops} stop${totalStops !== 1 ? 's' : ''}</strong> across <strong>${tbDays} day${tbDays !== 1 ? 's' : ''}</strong> &nbsp;·&nbsp; Est. ₹${totalCost.toLocaleString('en-IN')}/night total`;
    btn.disabled = false;
  }
}

// ── Drag from picker ──
function tbDragStartPicker(e, id) {
  const listing = tbAllListings.find(l => l._id === id);
  if (!listing) return;
  tbDragItem = { listing, fromDay: null };
  e.dataTransfer.effectAllowed = 'copy';
  e.currentTarget.classList.add('dragging');
  setTimeout(() => e.currentTarget.classList.remove('dragging'), 0);
}

// ── Drag from placed card ──
function tbDragStartPlaced(e, id, fromDay) {
  const listing = (tbPlan[fromDay] || []).find(l => l._id === id);
  if (!listing) return;
  tbDragItem = { listing, fromDay };
  e.dataTransfer.effectAllowed = 'move';
  e.currentTarget.classList.add('dragging');
  setTimeout(() => e.currentTarget.classList.remove('dragging'), 0);
}

function tbDragOver(e) {
  e.preventDefault();
  e.currentTarget.classList.add('drag-over');
}

function tbDragLeave(e) {
  e.currentTarget.classList.remove('drag-over');
}

function tbDrop(e, toDay) {
  e.preventDefault();
  e.currentTarget.classList.remove('drag-over');
  if (!tbDragItem) return;

  const { listing, fromDay } = tbDragItem;
  tbDragItem = null;

  // Remove from source day if dragging between days
  if (fromDay && fromDay !== toDay) {
    tbPlan[fromDay] = (tbPlan[fromDay] || []).filter(l => l._id !== listing._id);
  }

  // Don't add duplicate to same day
  if (!tbPlan[toDay]) tbPlan[toDay] = [];
  if (!tbPlan[toDay].find(l => l._id === listing._id)) {
    tbPlan[toDay].push(listing);
  }

  tbRenderCanvas();
}

// ── Controls ──
function tbAdjDays(delta) {
  const next = tbDays + delta;
  if (next < 1 || next > 14) return;
  tbDays = next;
  tbRenderCanvas();
}

function tbClearDay(key) {
  tbPlan[key] = [];
  tbRenderCanvas();
}

function tbClearAll() {
  tbPlan = {};
  tbRenderCanvas();
}

function tbRemove(day, id) {
  tbPlan[day] = (tbPlan[day] || []).filter(l => l._id !== id);
  tbRenderCanvas();
}

function tbSaveLocal() {
  localStorage.setItem('wl_tb_plan', JSON.stringify({ days: tbDays, plan: tbPlan }));
  const btn = document.querySelector('.tb-action-btn:nth-child(2)');
  if (btn) { btn.innerHTML = '<i class="fa-solid fa-check"></i> Saved!'; setTimeout(() => btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save', 1800); }
}

// ── Generate from builder ──
function tbGenerateFromBuilder() {
  const lines = [];
  for (let i = 1; i <= tbDays; i++) {
    const key   = `day${i}`;
    const items = tbPlan[key] || [];
    if (items.length > 0) {
      lines.push(`Day ${i}: ${items.map(l => `${l.title} (${l.location}, ${l.country} — ₹${l.price}/night)`).join(' → ')}`);
    } else {
      lines.push(`Day ${i}: (free / travel day)`);
    }
  }

  const prompt = `I have planned a ${tbDays}-day trip with these Wanderlust listings:

${lines.join('\n')}

Please build a detailed day-by-day itinerary around these stays. For each day include: morning, afternoon and evening activities near that listing's location, local food recommendations, estimated costs in INR, travel tips, and any hidden gems nearby.`;

  const btn = document.getElementById('tbGenBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Opening AI…';

  window.location.href = '/ai-assistant?prompt=' + encodeURIComponent(prompt);
}

// ── Start ──
document.addEventListener('DOMContentLoaded', tbInit);

</script>
