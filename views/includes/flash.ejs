<% if(success && success.length){ %>
    <div class="wl-alert success" style="max-width: 600px; margin: 0.75rem auto;">
        <i class="fa-solid fa-circle-check"></i>
        <%= success %>
        <button onclick="this.parentElement.remove()" style="margin-left:auto; background:none; border:none; cursor:pointer; color:inherit; font-size:1rem;">&times;</button>
    </div>
    <% } %>
    <% if(error && error.length){ %>
    <div class="wl-alert error" style="max-width: 600px; margin: 0.75rem auto;">
        <i class="fa-solid fa-circle-exclamation"></i>
        <%= error %>
        <button onclick="this.parentElement.remove()" style="margin-left:auto; background:none; border:none; cursor:pointer; color:inherit; font-size:1rem;">&times;</button>
    </div>
    <% } %>
    