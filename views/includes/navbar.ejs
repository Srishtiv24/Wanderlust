    <!-- Mobile Nav Links -->
    <ul class="wl-drawer-links">
      <li>
        <a href="/listings">
          <i class="fa-regular fa-compass"></i> Explore
        </a>
      </li>
      <% if(currUser) { %>
      <li>
        <a href="/wishlist">
          <i class="fa-regular fa-heart"></i> Favorites
        </a>
      </li>
      <% } %>
      <li>
        <a href="/ai-assistant">
          <span class="wl-ai-star">✦</span> AI Assistant
        </a>
      </li>
      <li>
        <a href="/itinerary">
          <i class="fa-regular fa-map"></i> Itinerary Planner
        </a>
      </li>
    </ul>

    <div class="wl-drawer-divider"></div>

