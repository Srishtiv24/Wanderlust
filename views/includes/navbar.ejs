<nav class="wl-navbar">
  <!-- Brand -->
  <a class="wl-brand" href="/listings">
    <div class="wl-brand-icon">
      <i class="fa-regular fa-compass"></i>
    </div>
    <div class="wl-brand-text">
      <span class="name">Wanderlust</span>
      <span class="tagline">Explore-Plan-Travel </span>
    </div>
  </a>

  <!-- Nav Links -->
  <ul class="wl-nav-links" id="wlNavLinks">
    <li>
      <a href="/listings" data-path="/listings"> <i class="fa-regular fa-compass"></i> Explore
      </a>
    </li>

    <% if(currUser) { %>
    <li>
      <a href="/wishlist" data-path="/wishlist"> <i class="fa-regular fa-heart"></i> Favorites
        <span class="fav-count" id="navFavCount" style="display:none;"></span>
      </a>
    </li>
    <% } %>

    <li>
      <a href="/ai-assistant" data-path="/ai-assistant"> <span class="wl-ai-star">✦</span> AI Assistant
      </a>
    </li>

    <li>
      <a href="/itinerary" data-path="/itinerary"> <i class="fa-solid fa-route"></i> Itinerary Planner
      </a>
    </li>
  </ul>

  <!-- Search Bar -->
  <div class="wl-search-bar">
    <i class="fa-solid fa-magnifying-glass search-icon"></i>
    <form action="/listings" method="GET">
      <input type="search" name="search" placeholder="Search"
        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
    </form>
  </div>

  <!-- Right Side -->

  <% if(currUser) { %>
  <div class="wl-user-pill">
    <div class="avatar"><%= currUser.username.charAt(0).toUpperCase() %></div>
    <div class="user-info">
      <span class="user-name"><%= currUser.username.charAt(0).toUpperCase() + currUser.username.slice(1) %></span>
    </div>
  </div>
