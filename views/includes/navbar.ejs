    <a href="/login" class="login">Log In</a>
  </div>
  <% } %>

  <% if(currUser) { %>
  <a href="/listings/new" class="wl-btn-primary" style="flex-shrink:0; text-decoration:none;">
    <i class="fa-solid fa-plus"></i> List Stay
  </a>
  <% } %>
  </div>

  <!-- Hamburger (mobile only) -->
  <button class="wl-hamburger" id="wlHamburger" aria-label="Toggle menu" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
